# ---------------------------------------------------------------- estado em disco
def p_comando() -> Path:
    return core.home() / "comando"


def p_estado() -> Path:
    return p_comando() / "estado.json"


def le_estado() -> dict | None:
    try:
        return json.loads(p_estado().read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None


def grava_estado(d: dict) -> None:
    p_comando().mkdir(parents=True, exist_ok=True)
    core._escrever_atomico(p_estado(), json.dumps(d, ensure_ascii=False, indent=2) + "\n")


def sala() -> list[str]:
    return [core.normaliza_ia(x) for x in core.config().get("na_sala", [])]


# Quem estes comandos tratam como DONO — o mesmo nome que é default de `--de`.
# Não vira campo de config: inventar `"dono"` no config.json exigiria migrar toda
# sala já existente para consertar um problema que uma constante resolve.
DONO = "bauer"


def voz(de: str) -> tuple[str, str]:
    """Quem assina o post.

    Devolve (autor, prefixo). Sem brain na sala, ninguém pode falar por ele — e
    inventar um autor seria pôr palavra na boca de uma IA que não disse aquilo.

    ⚠️ O desenho original assumia que o dono NÃO estava em `na_sala`: `voz("bauer")`
    caía no ramo do brain e a orquestradora assinava com o prefixo "📣 do dono",
    declarando a procedência. Em 18/08 ele entrou na sala pelo app — e o MESMO código
    passou a devolver `("bauer", "")`, assinando COMO ele, sem prefixo. A premissa
    mudou embaixo do código; o código não soube. Por isso o guarda-corpo do `--de`
    (`autor`) existe: aqui não dá para saber quem digitou.
    """
    de = core.normaliza_ia(de)
    if de in sala():
        return de, ""
    brain = core.normaliza_ia(core.config().get("brain", ""))
    if brain not in sala():
        raise ValueError(
            f"'{de}' não está na sala {sala()} e não há brain para falar por ele. "
            f"Ajuste `na_sala`/`brain` em {core.p_config()}."
        )
    return brain, f"📣 **do dono ({de}):**\n\n"


def autor(a) -> str:
    """Quem assina — resolvido na hora de assinar, nunca antes.

    O dono só assina o que ele digitou.

    `--de` tem padrão `bauer` porque estes comandos são DELE: ele digita
    `iachat-comando goal "..."` e não deveria ter que se identificar na própria máquina.
    Mas uma IA que dispare o mesmo comando sem `--de` faz a mensagem sair ASSINADA POR
    ELE — e as outras IAs leem a sala e OBEDECEM. Esta casa já teve uma mensagem-fantasma
    assinada `bauer` que ele não escreveu; `decidi` é pior ainda, porque registra decisão
    que todas obedecem.

    O sinal barato que separa os dois casos: um humano digitando tem TTY; um subprocesso
    disparado por uma IA, não. Sem TTY e sem `--de`, exigimos o autor explícito em vez de
    assinar por ele.

    NÃO é infalível — uma casca que aloque TTY volta ao padrão —, e por isso não é a
    única defesa: `prompt_de` declara a procedência no texto do despacho. Um guarda-corpo
    que pega o caso real vale mais que a trava perfeita que ninguém escreve.

    ⚠️ Chamada AQUI, no ponto de uso, e não no `main()`. Rodando no `main()` ela
    disparava antes das validações de estado: `plan` sem `goal` respondia "diga quem
    está falando" em vez de "não há objetivo", e o `plan` sequer assina nada — recebe
    `--de` e nunca o usa. O gate `teste_comandos.py` pegou isso, reprovando dois T-RED
    que cobram a mensagem certa. Erro deve falar do problema que o usuário tem, não do
    próximo da fila.
    """
    de = getattr(a, "de", None)
    if de is not None:
        # `--de ""` passava e gravava autor VAZIO — mensagem sem dono, que é pior que
        # mensagem com dono errado: não dá nem para perguntar a quem. Achado B2 da
        # auditoria h2. Vazio não é "não informou" (isso é `None`): é um valor que
        # alguém digitou e que não identifica ninguém.
        if not de.strip():
            raise ValueError(
                "`--de` vazio não identifica ninguém, e mensagem sem dono é pior que "
                "mensagem com dono errado.\n"
                f"  Diga quem está falando:  --de claude   (ou codex, kimi, qwen, {DONO}…)"
            )
        return de                                 # explícito: quem digitou se nomeou
    if sys.stdin.isatty():
        return DONO                               # ele, no terminal dele
    raise ValueError(
        f"sem terminal e sem `--de`: eu assinaria como '{DONO}' uma mensagem que ele não "
        f"digitou, e as outras IAs da sala obedeceriam.\n"
        f"  Diga quem está falando:  --de claude   (ou codex, kimi, qwen, …)\n"
        f"  Se for mesmo ele:        --de {DONO}"
    )


def anuncia(de: str, texto: str, para: list[str]) -> dict | None:
    """Posta na sala. Falha de post não derruba o comando — o disco já foi gravado."""
    try:
        # `quem`, não `autor`: existe uma FUNÇÃO `autor(a)` no módulo, e reusar o nome
        # aqui a sombreia. Não quebra hoje (ela não é chamada nesta função), mas é o
        # tipo de alçapão que só dispara quando alguém editar isto daqui a meses.
        quem, prefixo = voz(de)
        return core.post(quem, prefixo + texto, para)
    except ValueError as e:
        print(f"⚠️  não anunciado na sala: {e}", file=sys.stderr)
        return None


# ---------------------------------------------------------------- processos
def _ps(pid: int, campo: str) -> str:
    """Um campo do `ps` para UM pid. Vazio = processo não existe mais."""
    try:
        r = subprocess.run(
            ["ps", "-o", f"{campo}=", "-p", str(pid)],
            capture_output=True, text=True, timeout=10,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    return r.stdout.strip() if r.returncode == 0 else ""


def esta_vivo(pid: int) -> bool:
    """Zumbi NÃO é vivo — e `ps -o pid=` não sabe a diferença.

    Medido em 18/08: depois de um SIGKILL certeiro, `ps -o pid= -p PID` continuava
    devolvendo o número enquanto o pai não colhia o filho, e o `parar` anunciava
    "ainda de pé" para um processo que já tinha morrido. `ps -o state=` devolve `Z`
    para o defunto. Contar zumbi como vivo é a mesma mentira do painel que este
    programa existe para denunciar, só que do meu lado.
    """
    est = _ps(pid, "state")
    return bool(est) and not est.startswith("Z")


def confere_dono(w: dict, missao: str) -> tuple[str, str]:
    """O gate do `parar`. Devolve (veredito, motivo).

    veredito ∈ {ok, morto, recusado}. `recusado` é fail-closed: na dúvida sobre a
    identidade do processo, NÃO se mata. Um worker que sobrevive custa uma segunda
    tentativa; um PID reciclado morto custa o processo de outra pessoa.
    """
    pid = w.get("pid")
    if not isinstance(pid, int) or pid <= 1:
        return "recusado", f"pid inválido no estado: {pid!r}"
    if pid == os.getpid() or pid == os.getppid():
        return "recusado", f"pid {pid} é este próprio comando"
    lstart = _ps(pid, "lstart")
    if not lstart or not esta_vivo(pid):
        return "morto", "processo já não existe"
    if lstart != w.get("lstart"):
        return "recusado", (
            f"PID {pid} RECICLADO: nasceu em {lstart!r}, o worker nasceu em "
            f"{w.get('lstart')!r} — é outro processo"
        )
    # A marca é o caminho ABSOLUTO do prompt daquele worker, não o id da missão: `m1`
    # é curto o bastante para aparecer por acaso em qualquer linha de comando, e uma
    # marca que casa por acaso não prova nada.
    marca = w.get("prompt") or missao
    cmd = _ps(pid, "command")
    if marca not in cmd:
        return "recusado", (
            f"PID {pid} não carrega a marca do worker ({marca}) na linha de comando: {cmd[:120]!r}"
        )
    return "ok", cmd[:120]


def vivo(w: dict, missao: str) -> bool:
    return confere_dono(w, missao)[0] == "ok"


def mata(pid: int, sig: int) -> str:
    """Mata o GRUPO quando o pid é líder de grupo; só o pid quando não é."""
    try:
        if os.getpgid(pid) == pid:
            os.killpg(pid, sig)
            return "grupo"
        os.kill(pid, sig)
        return "processo"
    except (ProcessLookupError, PermissionError, OSError) as e:
        return f"erro: {e}"


# ------------------------------------------- runs do iaswarm (dado de outro programa)
# Um run do iaswarm (`~/.claude/iaswarm-runs/<nome>`) NÃO é uma missão deste comando:
# ele nasce do `dispatch.sh`, que grava `logs/<worker>.pid` mas não grava o instante de
# nascimento do processo. Sem `lstart` guardado, o gate do PID reciclado precisa de
# outra prova — e há duas, ambas já no disco:
#
#   1. o caminho ABSOLUTO do run aparece na linha de comando do worker, porque o
#      protocolo manda "cumpra o contrato em $RUN/…" (dispatch.sh:27-34);
#   2. o processo nasceu ANTES de o `.pid` existir, porque o shell escreve o arquivo
#      logo depois do fork. `lstart` posterior ao mtime do `.pid` = PID reciclado.
#
# Nada disto usa `pkill -f`. `pkill -f <nome>` casa a PRÓPRIA linha de comando de quem
# procura e casa o PATH de qualquer processo que só mencione o nome — é como se mata o
# processo errado. Aqui a busca é por PID gravado, conferido contra o `ps`.
TOLERANCIA_NASCIMENTO_S = 60


def _tabela_ps() -> list[tuple[int, int, str]]:
    """(pid, ppid, command) de tudo que roda, numa chamada só."""
    try:
        r = subprocess.run(["ps", "-Ao", "pid=,ppid=,command="],
                           capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return []
    out = []
    for ln in r.stdout.splitlines():
        p = ln.split(None, 2)
        if len(p) == 3 and p[0].isdigit() and p[1].isdigit():
            out.append((int(p[0]), int(p[1]), p[2]))
    return out


def _minha_linhagem(tabela: list[tuple[int, int, str]]) -> set[int]:
    """Eu e meus ancestrais, por PID.

    A linha de comando de `iachat-comando quem --run <dir>` CONTÉM o caminho do run:
    sem me excluir, eu apareceria como "processo vivo citando este run" no meu próprio
    diagnóstico. A exclusão é por PID e não por nome porque nome casa por acaso —
    medido em 18/08: o filtro `"iachat-comando" not in cmd` engoliu um órfão legítimo
    só porque o diretório do teste se chamava `iachat-comandos-teste-…`.
    """
    pais = {p: pp for p, pp, _ in tabela}
    meus, atual = set(), os.getpid()
    while atual and atual not in meus:
        meus.add(atual)
        atual = pais.get(atual, 0)
    return meus


def descendentes(pid: int, tabela: list[tuple[int, int, str]]) -> list[int]:
    """A árvore abaixo de `pid`, das folhas para a raiz — a ordem em que se mata.

    Worker do iaswarm NÃO é líder de grupo (o `dispatch.sh` não faz setsid), então
    `killpg` ali derrubaria o grupo do dispatch inteiro, com os IRMÃOS dentro. Descer
    por ppid mata só o que de fato desce deste pid.
    """
    filhos: dict[int, list[int]] = {}
    for p, pp, _ in tabela:
        filhos.setdefault(pp, []).append(p)
    ordem, fila = [], [pid]
    while fila:
        atual = fila.pop(0)
        for f in filhos.get(atual, []):
            if f not in ordem and f != atual:
                ordem.append(f)
                fila.append(f)
    return list(reversed(ordem))


def _sinaliza(pids: list[int], sig: int) -> list[int]:
    atingidos = []
    for p in pids:
        try:
            os.kill(p, sig)
            atingidos.append(p)
        except (ProcessLookupError, PermissionError, OSError):
            pass
    return atingidos


def _insiste(pids: list[int], espera: float) -> list[int]:
    """Espera a saída educada e manda SIGKILL em quem ficou. Devolve os teimosos."""
    fim = time.time() + max(espera, 0.1)
    while time.time() < fim:
        if not any(esta_vivo(p) for p in pids):
            return []
        time.sleep(0.15)
    teimosos = [p for p in pids if esta_vivo(p)]
    if teimosos:
        _sinaliza(teimosos, signal.SIGKILL)
        time.sleep(0.4)
    return teimosos


def _nascimento(pid: int) -> datetime | None:
    """Quando o processo nasceu, por `etime` — aritmética, sem idioma no meio.

    NÃO usa `lstart` + strptime: nesta máquina o `ps` responde em português
    (`'ter 18 ago 03:39:08 2026'`), e `%a %b` em inglês levanta ValueError. Medido em
    18/08 com o gate já escrito: ele devolvia None em silêncio e o veredito caía em
    "vivo" — um gate morto que parecia aprovado. `etime` é `[[dd-]hh:]mm:ss`, número
    puro, igual em qualquer locale.

    (Em `confere_dono` o `lstart` continua sendo usado, e lá isso não é problema: a
    comparação é de STRING contra a string gravada no despacho, nunca de data.)
    """
    bruto = _ps(pid, "etime")
    if not bruto:
        return None
    dias, _, resto = bruto.rpartition("-")
    partes = resto.split(":")
    try:
        nums = [float(x) for x in partes]
    except ValueError:
        return None
    seg = 0.0
    for n in nums:                      # mm:ss ou hh:mm:ss
        seg = seg * 60 + n
    if dias:
        try:
            seg += float(dias) * 86400
        except ValueError:
            return None
    return datetime.now().astimezone() - timedelta(seconds=seg)


def le_run(d: Path) -> dict:
    """Lê um run do iaswarm. READ-ONLY: não cria, não escreve, não pega lock."""
    bruto = Path(d).expanduser()
    d = bruto.resolve()
    if not (d / "workers.tsv").is_file():
        raise ValueError(f"{d} não parece um run do iaswarm (sem workers.tsv)")
    tabela = _tabela_ps()
    # DUAS grafias do mesmo diretório, porque o processo foi lançado com UMA delas e
    # `ps` devolve o texto literal: `/var/folders/…` resolve para `/private/var/…` no
    # macOS. Comparar só a resolvida faria todo worker de um caminho com symlink cair
    # em "não-verificável" — o instrumento diria "não sei" sobre um worker que sabe.
    marcas = {str(d), str(bruto)}

    def cita_o_run(linha: str) -> bool:
        return any(m in linha for m in marcas)
    workers: dict[str, dict] = {}
    for tsv in sorted(d.glob("workers*.tsv")):
        for ln in tsv.read_text(encoding="utf-8", errors="replace").splitlines():
            if not ln.strip() or ln.lstrip().startswith("#"):
                continue
            campos = ln.split("\t")
            w = campos[0].strip()
            if not w:
                continue
            workers[w] = {
                "braco": campos[1].strip() if len(campos) > 1 else "?",
                "etapas": campos[2].strip() if len(campos) > 2 else "?",
                "contrato": campos[3].strip() if len(campos) > 3 else "",
                "tsv": tsv.name,
            }

    for w, info in workers.items():
        pidf = d / "logs" / f"{w}.pid"
        res = d / "resultados" / f"{w}.md"
        info["entregue"] = res.is_file() and res.stat().st_size > 0
        info["resultado"] = str(res)
        if not pidf.is_file():
            info.update(veredito="nao-verificavel", pid=None,
                        motivo=f"sem logs/{w}.pid: o disco não prova nem nega")
            continue
        try:
            pid = int(pidf.read_text(encoding="utf-8").strip())
        except (OSError, ValueError):
            info.update(veredito="nao-verificavel", pid=None,
                        motivo=f"logs/{w}.pid ilegível")
            continue
        info["pid"] = pid
        info["despachado_em"] = datetime.fromtimestamp(pidf.stat().st_mtime).astimezone()
        linha = next((c for p, _, c in tabela if p == pid), None)
        if linha is None:
            info.update(veredito="morto", motivo="pid não está no ps")
            continue
        info["cmd"] = linha[:140]
        if not esta_vivo(pid):
            info.update(veredito="morto", motivo="zumbi (defunto, pai ainda não colheu)")
            continue
        if not cita_o_run(linha):
            info.update(veredito="nao-verificavel",
                        motivo=f"pid {pid} existe mas NÃO cita este run: {linha[:70]!r}")
            continue
        nasc = _nascimento(pid)
        if nasc and nasc > info["despachado_em"] + timedelta(seconds=TOLERANCIA_NASCIMENTO_S):
            info.update(veredito="nao-verificavel",
                        motivo=(f"pid {pid} nasceu {nasc:%H:%M:%S}, DEPOIS do despacho "
                                f"{info['despachado_em']:%H:%M:%S} — reciclado"))
            continue
        info.update(veredito="vivo", nasceu=nasc, motivo="pid no ps, citando este run")

    # Vivos que o run NÃO registrou: o `.pid` ausente não é prova de morte. Aconteceu
    # de verdade em 18/08 — `d1-watchdog` rodando sem `.pid` e sem linha no workers.tsv.
    conhecidos = {i.get("pid") for i in workers.values() if i.get("pid")}
    orfaos = [
        (p, c[:140]) for p, _, c in tabela
        if cita_o_run(c) and p not in conhecidos and p not in _minha_linhagem(tabela)
    ]
    return {"dir": d, "workers": workers, "orfaos": orfaos}


# ---------------------------------------------------------------- tempo
def desde(iso: str | None) -> str:
    if not iso:
        return "—"
    try:
        t = datetime.fromisoformat(iso)
    except ValueError:
        return "—"
    s = (datetime.now().astimezone() - t).total_seconds()
    if s < 90:
        return f"há {int(s)}s"
    if s < 5400:
        return f"há {int(s // 60)}min"
    if s < 172800:
        return f"há {s / 3600:.1f}h"
    return f"há {int(s // 86400)}d"


# ---------------------------------------------------------------- /goal
def cmd_goal(a) -> int:
    texto = " ".join(a.texto).strip()
    if not texto:
        print("✗ objetivo vazio. `/goal` é o enunciado — sem ele o `/plan` não tem o que pedir.",
              file=sys.stderr)
        return 2

    velho = le_estado()
    if velho and velho.get("estado") in ESTADOS_VIVOS and not a.novo:
        rodando = [i for i, w in velho.get("workers", {}).items() if vivo(w, velho["id"])]
        if rodando:
            print(
                f"✗ a missão {velho['id']} ainda tem {len(rodando)} worker(s) vivo(s): "
                f"{', '.join(rodando)}.\n"
                f"  Trocar o objetivo agora abandonaria eles rodando às cegas.\n"
                f"  `iachat-comando parar` encerra, ou `--novo` assume o abandono.",
                file=sys.stderr,
            )
            return 3

    n = int(velho["id"].lstrip("m")) + 1 if velho and str(velho.get("id", "")).startswith("m") else 1
    mid = f"m{n}"
    d = p_comando() / mid
    (d / "logs").mkdir(parents=True, exist_ok=True)
    (d / "planos").mkdir(parents=True, exist_ok=True)
    grava_estado({
        "id": mid, "goal": texto, "de": core.normaliza_ia(autor(a)),
        "criado": core.agora(), "estado": "aberta", "dir": str(d), "workers": {},
    })
    (d / "goal.md").write_text(f"# {mid} · objetivo\n\n{texto}\n", encoding="utf-8")

    print(f"🎯 {mid} · objetivo registrado")
    print(f"   {texto}")
    print(f"   {d}")
    if not a.calado:
        r = anuncia(autor(a), f"**Objetivo da missão {mid}**\n\n{texto}\n\n"
                          f"Nada a aplicar ainda. O plano vem pelo `/plan`; aplicar, só no `/concluir`.",
                    ["all"])
        if r:
            print(f"   ↪ anunciado na sala como #{r['n']}")
    print("   próximo: `iachat-comando plan`")
    return 0


# ---------------------------------------------------------------- /plan
CONFRONTO_INICIO = "<!-- IACHAT-CONFRONTO:INICIO -->"
CONFRONTO_FIM = "<!-- IACHAT-CONFRONTO:FIM -->"
TITULO_DIVERGE = "**Divergem**"
MAX_ITENS_CONFRONTO = 8


def _token_confronto(texto: str) -> str:
    """Normaliza chave/enum sem tentar entender a prosa do plano."""
    ascii_texto = "".join(
        c for c in unicodedata.normalize("NFKD", texto)
        if not unicodedata.combining(c)
    ).lower()
    return re.sub(r"[^a-z0-9]+", "-", ascii_texto).strip("-")


def _valor_confronto(texto: str) -> str:
    """Forma conservadora usada só para decidir igualdade textual."""
    return _token_confronto(texto).replace("-", " ")


def _curto(texto: str, limite: int = 180) -> str:
    """O contrato pode resumir; o corpo do plano nunca entra na sala."""
    uma_linha = " ".join(texto.split())
    return uma_linha if len(uma_linha) <= limite else uma_linha[:limite - 1] + "…"


def _le_contrato_confronto(texto: str, missao: str) -> tuple[dict | None, str]:
    """Lê o bloco explícito; texto livre nunca é promovido a consenso por palpite."""
    ini = texto.find(CONFRONTO_INICIO)
    fim = texto.find(CONFRONTO_FIM, ini + len(CONFRONTO_INICIO)) if ini >= 0 else -1
    if ini < 0 or fim < 0:
        return None, "contrato IACHAT-CONFRONTO ausente"

    campos, claims = {}, {}
    em_claims = False
    bloco = texto[ini + len(CONFRONTO_INICIO):fim]
    for numero, crua in enumerate(bloco.splitlines(), 1):
        linha = crua.strip()
        if not linha:
            continue
        if linha == "claims:":
            em_claims = True
            continue
        if em_claims:
            if not linha.startswith("-") or "|" not in linha:
                return None, f"claim inválido na linha {numero} do contrato"
            chave_crua, valor = linha[1:].split("|", 1)
            chave = _token_confronto(chave_crua)
            valor = _curto(valor)
            if not chave or not valor:
                return None, f"claim vazio na linha {numero} do contrato"
            if chave in claims:
                return None, f"claim duplicado: {chave}"
            claims[chave] = {"texto": valor, "normal": _valor_confronto(valor)}
            continue
        if ":" not in linha:
            return None, f"campo inválido na linha {numero} do contrato"
        chave, valor = linha.split(":", 1)
        chave = _token_confronto(chave).replace("-", "_")
        if chave in campos:
            return None, f"campo duplicado: {chave}"
        campos[chave] = valor.strip()

    obrigatorios = ("objetivo_id", "recomendacao", "aplicar_agora", "tamanho")
    faltam = [x for x in obrigatorios if not campos.get(x)]
    if faltam:
        return None, "faltam campos: " + ", ".join(faltam)
    if campos["objetivo_id"] != missao:
        return None, f"objetivo_id={campos['objetivo_id']} não corresponde a {missao}"
    if not claims:
        return None, "claims vazio"

    enums = {
        "recomendacao": {"favoravel", "contraria", "condicional", "inconclusiva"},
        "aplicar_agora": {"sim", "nao", "condicional", "inconclusivo"},
        "tamanho": {"pequeno", "medio", "grande", "inconclusivo"},
    }
    canonicos = {}
    for campo, permitidos in enums.items():
        valor = _token_confronto(campos[campo])
        if valor not in permitidos:
            return None, f"{campo} fora do vocabulário: {campos[campo]}"
        canonicos[campo] = valor
    return {"campos": canonicos, "claims": claims}, ""


def _limita_itens(itens: list[str]) -> list[str]:
    """Mantém a sala pequena mesmo quando os planos trazem muitos sinais."""
    if len(itens) <= MAX_ITENS_CONFRONTO:
        return itens
    sobra = len(itens) - MAX_ITENS_CONFRONTO
    return itens[:MAX_ITENS_CONFRONTO] + [
        f"- +{sobra} item(ns); detalhes nos planos completos."
    ]


def _confronta_planos(dados: dict[str, dict], total: int,
                      problemas: dict[str, str]) -> list[str]:
    """Compara somente campos/chaves declarados por todos; dúvida fica explícita."""
    if total < 2 or len(dados) != total:
        linhas = [
            "**Confronto indisponível** — não inventei consenso: "
            f"só {len(dados)} de {total} planos entregues tem contrato comparável."
        ]
        linhas += [f"- **{ia}:** {motivo}" for ia, motivo in problemas.items()]
        return linhas

    ias = list(dados)
    concordam, divergem, unicos = [], [], []
    nomes_campos = {
        "recomendacao": "recomendação",
        "aplicar_agora": "aplicar agora",
        "tamanho": "tamanho",
    }
    for campo in ("recomendacao", "aplicar_agora", "tamanho"):
        por_ia = {ia: dados[ia]["campos"][campo] for ia in ias}
        if len(set(por_ia.values())) == 1:
            concordam.append(f"- **{nomes_campos[campo]}:** {next(iter(por_ia.values()))}")
        else:
            lados = " · ".join(f"**{ia}:** {valor}" for ia, valor in por_ia.items())
            divergem.append(f"- **{nomes_campos[campo]}** — {lados}")

    por_chave: dict[str, dict[str, dict]] = {}
    for ia in ias:
        for chave, claim in dados[ia]["claims"].items():
            por_chave.setdefault(chave, {})[ia] = claim
    for chave, por_ia in por_chave.items():
        if len(por_ia) == total:
            valores = {x["normal"] for x in por_ia.values()}
            if len(valores) == 1:
                concordam.append(f"- `{chave}` — {next(iter(por_ia.values()))['texto']}")
            else:
                lados = " · ".join(
                    f"**{ia}:** {por_ia[ia]['texto']}" for ia in ias
                )
                divergem.append(f"- `{chave}` — {lados}")
        elif len(por_ia) == 1:
            ia, claim = next(iter(por_ia.items()))
            unicos.append(f"- só **{ia}**: `{chave}` — {claim['texto']}")
        else:
            nomes = ", ".join(f"**{ia}**" for ia in por_ia)
            claim = next(iter(por_ia.values()))
            unicos.append(f"- só {nomes}: `{chave}` — {claim['texto']}")

    linhas = ["**Concordam**"]
    linhas += _limita_itens(concordam or ["- nenhum consenso estrutural explícito."])
    linhas += ["", TITULO_DIVERGE]
    linhas += _limita_itens(divergem or ["- nenhuma divergência estrutural explícita."])
    linhas += ["", "**Cobertura única**"]
    linhas += _limita_itens(unicos or ["- nenhum ponto exclusivo declarado."])
    return linhas


def prompt_de(ia: str, e: dict, papel: str, retomada: str = "") -> str:
    plano = Path(e["dir"]) / "planos" / f"{ia}.md"
    # QUEM pediu vem do estado (`cmd_goal` grava `"de"`), nunca de suposição. O texto
    # dizia "O DONO da máquina definiu" mesmo quando o goal era de outra pessoa — e um
    # worker que lê isso trata a proposta como ordem dele. Achado do g2 em 18/08, numa
    # rodada que a própria orquestradora propôs com o dono dormindo.
    # Sem `"de"` no estado, a origem é DESCONHECIDA — não é o dono. O fallback era
    # `DONO`, o mesmo padrão que já foi corrigido em `colher()`: "não sei quem pediu"
    # não pode virar "foi ele" só porque é o valor mais provável. Achado I3 da auditoria
    # h2, que notou a incoerência entre os dois pontos. Alcançável só por estado gravado
    # antes de o campo existir — mas é exatamente onde a suposição passa despercebida.
    quem = core.normaliza_ia(e.get("de") or "")
    if quem == DONO:
        origem = "O DONO da máquina definiu este objetivo:"
    elif quem:
        origem = f"{quem} PROPÔS este objetivo (proposta de uma IA — NÃO é ordem do dono):"
    else:
        origem = ("Este objetivo está registrado SEM AUTOR (estado antigo). Trate como "
                  "proposta a planejar, NÃO como ordem do dono:")
    return (
        f"PEDIDO DE PLANO — missão {e['id']} · sala ia-chat\n\n"
        f"{origem}\n\n    {e['goal']}\n\n"
        f"Você é {ia}. Seu ângulo nesta rodada: {papel}.\n"
        f"Devolva UM PLANO. NÃO aplique nada, NÃO edite arquivo de produção: planejar é "
        f"barato e reversível, aplicar não. Aplicar só depois que o dono autorizar.\n\n"
        f"ESCREVA O PLANO EM: {plano}\n"
        f"COMECE o arquivo por este contrato curto, antes da prosa. Ele permite que o "
        f"`--colher` confronte os planos localmente, sem mandar os corpos a outra IA:\n\n"
        f"{CONFRONTO_INICIO}\n"
        f"objetivo_id: {e['id']}\n"
        f"recomendacao: favoravel|contraria|condicional|inconclusiva\n"
        f"aplicar_agora: sim|nao|condicional|inconclusivo\n"
        f"tamanho: pequeno|medio|grande|inconclusivo\n"
        f"claims:\n"
        f"- chave-estavel-sem-acentos | afirmação curta\n"
        f"{CONFRONTO_FIM}\n\n"
        f"Escolha UM valor em cada linha, não copie as opções. Use no máximo 12 claims; "
        f"a chave identifica o conceito (não a ordem do item). Se outro plano usar a "
        f"mesma chave com outro valor, o confronto mostrará a divergência; chaves que "
        f"apareçam em um só braço serão cobertura única.\n\n"
        f"Formato: o que fazer · em que ordem · o que cada passo custa · o que pode dar "
        f"errado · o que você NÃO consegue fazer. Cite arquivo:linha ao falar de código; "
        f"alegação sem arquivo:linha não conta.\n\n"
        f"A sala fica em {core.p_chat()}. Antes de propor, leia o que já foi decidido: "
        f"`iachat-decide decisoes`.\n"
        + (f"\nRETOMADA — você já tinha escrito isto antes de cair; continue de onde parou, "
           f"não recomece:\n\n{retomada}\n" if retomada else "")
    )


def despacha(ia: str, braco: str, e: dict, papel: str, retomada: str = "") -> dict:
    d = Path(e["dir"])
    pr = d / "logs" / f"{ia}.prompt.txt"
    log = d / "logs" / f"{ia}.log"
    plano = d / "planos" / f"{ia}.md"
    pr.write_text(prompt_de(ia, e, papel, retomada), encoding="utf-8")

    despachante = os.environ.get("IACHAT_DESPACHO", str(DESPACHO_PADRAO))
    argv = [despachante, braco, e["id"], str(pr), str(log), str(plano)]
    # start_new_session: o filho vira líder do próprio grupo. É o que torna o /parar
    # capaz de derrubar a árvore inteira em vez de decapitar a casca e deixar o motor.
    p = subprocess.Popen(
        argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        stdin=subprocess.DEVNULL, start_new_session=True, cwd=str(d),
    )
    lstart = ""
    for _ in range(20):  # o `ps` só enxerga o processo depois que ele existe de fato
        lstart = _ps(p.pid, "lstart")
        if lstart:
            break
        time.sleep(0.05)
    return {
        "braco": braco, "papel": papel, "pid": p.pid, "lstart": lstart,
        "inicio": core.agora(), "estado": "rodando", "tentativas": 1,
        "log": str(log), "plano": str(plano), "prompt": str(pr),
    }


def _normaliza_enunciado(texto: str) -> str:
    """Minúsculas sem acento — o casamento é de vocabulário, não de prosa."""
    return "".join(
        c for c in unicodedata.normalize("NFKD", texto.casefold())
        if not unicodedata.combining(c)
    )


def _contem_sinal(texto_n: str, sinal: str) -> bool:
    """Frase casa por substring; palavra curta, por fronteira — 'cada' não pega 'cadastrar'."""
    sinal_n = _normaliza_enunciado(sinal)
    if not sinal_n:
        return False
    if " " in sinal_n or ":" in sinal_n:
        return sinal_n in texto_n
    return re.search(rf"(?<![a-z0-9]){re.escape(sinal_n)}(?![a-z0-9])", texto_n) is not None


def casa_afinidades(enunciado: str, candidatas: list[str]) -> list[dict]:
    """Quem da sala casa com o enunciado, e por QUAL palavra.

    Devolve na ordem de quem casou mais, empate na ordem da sala. Sem casamento
    não inventa vocação: a lista vazia é o sinal de 'não reconheci'.
    """
    texto_n = _normaliza_enunciado(enunciado)
    achados = []
    for ia in candidatas:
        palavras = AFINIDADE.get(ia, ())
        casou = [p for p in palavras if _contem_sinal(texto_n, p)]
        if casou:
            achados.append({
                "ia": ia, "palavra": casou[0], "n": len(casou),
                "papel": PAPEL_PADRAO.get(ia, "plano geral"),
            })
    achados.sort(key=lambda x: (-x["n"], candidatas.index(x["ia"])))
    return achados


def estima_nivel(enunciado: str, casadas: list[dict]) -> tuple[int, str, bool]:
    """(nível, critério, reconheceu).

    A frase começa com 'estimei' de propósito: isto é chute declarado, não
    veredito. Zero vocação casa → nível 3 e o critério diz que caiu por não
    reconhecer. Uma estimativa que devolve 'ninguém' é pior que despachar demais.
    """
    texto_n = _normaliza_enunciado(enunciado)
    n_palavras = len(texto_n.split())
    if not casadas:
        return 3, "não reconheci a tarefa; caí no nível 3", False
    if any(_contem_sinal(texto_n, s) for s in SINAIS_NIVEL_3):
        return 3, "estimei nível 3 porque o enunciado pede varredura, auditoria ou várias frentes", True
    if any(_contem_sinal(texto_n, s) for s in SINAIS_NIVEL_2):
        return 2, "estimei nível 2 porque há uma frente e um pedido de verificação", True
    if any(_contem_sinal(texto_n, s) for s in SINAIS_NIVEL_1) or (
            n_palavras <= 10 and len(casadas) <= 1):
        return 1, "estimei nível 1 porque o escopo cabe num arquivo, numa linha ou numa pergunta", True
    if len(casadas) >= 3:
        return 3, "estimei nível 3 porque várias vocações casaram com o enunciado", True
    if len(casadas) == 2:
        return 2, "estimei nível 2 porque duas vocações casaram (frente + complemento)", True
    return 1, "estimei nível 1 porque só uma vocação casou e o enunciado não pede frota", True


def escolhe_pelo_nivel(nivel: int, casadas: list[dict],
                       candidatas: list[str]) -> list[str]:
    """Nível escolhe QUANTAS; a afinidade escolhe QUAIS, entre as da sala.

    Nível 1: a de maior afinidade. Nível 2: ela + quem prova (grok se estiver
    na sala; senão a próxima da sala). Nível 3: todas as que casaram; se
    ninguém casou, a sala inteira (menos brain e dono, que já saíram da lista).
    """
    if not candidatas:
        return []
    if nivel == 1:
        return [casadas[0]["ia"]] if casadas else [candidatas[0]]
    if nivel == 2:
        primeira = casadas[0]["ia"] if casadas else candidatas[0]
        resto = [x for x in candidatas if x != primeira]
        prova = QUEM_PROVA if QUEM_PROVA in resto else (resto[0] if resto else None)
        return [primeira] + ([prova] if prova else [])
    if casadas:
        nomes = {c["ia"] for c in casadas}
        return [x for x in candidatas if x in nomes]
    return list(candidatas)


def sala_operaria() -> tuple[list[str], str, str]:
    """Quem pode ser operária do plano: a sala menos o brain e o dono.

    A orquestradora não se despacha — ela está rodando este comando. O dono
    também não: `na_sala` passou a tê-lo quando ele entrou pelo app, e um
    worker com o nome dele cairia em 'braço sem adaptador'. Destinatário do
    plano, nunca operário. Isto não se negocia nem com `--ias`.
    """
    brain = core.normaliza_ia(core.config().get("brain", ""))
    operarias = [x for x in sala() if x not in (brain, DONO)]
    return operarias, brain, DONO


def calibra_plan(enunciado: str, candidatas: list[str], *,
                 ias: list[str] | None = None, nivel: int | None = None,
                 todas: bool = False, brain: str | None = None) -> dict:
    """Decide quem planeja. `--ias` > `--todas` > `--nivel` > estimativa.

    Nunca devolve lista vazia quando ainda há alguém na sala: zero alvos é
    pior que despachar demais. Quem ficou de fora e por quê vai no `--seco`.
    """
    casadas = casa_afinidades(enunciado, candidatas)
    if brain is None:
        brain = core.normaliza_ia(core.config().get("brain", ""))

    if ias:
        alvos, recusadas = [], []
        for ia in ias:
            if ia in (DONO, brain):
                recusadas.append(ia)
                continue
            if ia not in alvos:
                alvos.append(ia)
        return {
            "alvos": alvos, "nivel": None, "origem": "ias",
            "criterio": "--ias soberano (estimativa calada)",
            "reconheceu": True, "casadas": casadas, "recusadas": recusadas,
        }
    if todas:
        return {
            "alvos": list(candidatas), "nivel": 3, "origem": "todas",
            "criterio": "--todas: sala menos brain e dono (o comportamento antigo)",
            "reconheceu": True, "casadas": casadas, "recusadas": [],
        }
    if nivel in (1, 2, 3):
        # Cravar 3 é pedir a frota da sala, não "só quem a heurística casou":
        # se a estimativa já tivesse acertado, ele não cravava.
        alvos = (list(candidatas) if nivel == 3
                 else escolhe_pelo_nivel(nivel, casadas, candidatas))
        return {
            "alvos": alvos, "nivel": nivel, "origem": "cravado",
            "criterio": f"nível {nivel} cravado por --nivel (estimativa calada)",
            "reconheceu": True, "casadas": casadas, "recusadas": [],
        }

    n, criterio, reconheceu = estima_nivel(enunciado, casadas)
    alvos = escolhe_pelo_nivel(n, casadas, candidatas)
    return {
        "alvos": alvos, "nivel": n, "origem": "estimado",
        "criterio": criterio, "reconheceu": reconheceu,
        "casadas": casadas, "recusadas": [],
    }


def imprime_calibracao(cal: dict, candidatas: list[str], e: dict, a) -> None:
    """O `--seco` é onde a estimativa se assume. Sem isto ele não decide."""
    alvos = cal["alvos"]
    print(f"🧪 seco — missão {e['id']}: {cal['criterio']}")
    print(f"   {len(alvos)} IA(s) seriam despachadas")
    for ia in alvos:
        casou = next((c for c in cal["casadas"] if c["ia"] == ia), None)
        if cal["origem"] == "ias":
            motivo = "nomeada em --ias"
        elif cal["origem"] == "todas":
            motivo = "--todas"
        elif casou:
            motivo = f"palavra «{casou['palavra']}»"
        elif not cal["reconheceu"]:
            motivo = "caiu no nível 3 sem vocação casada"
        else:
            motivo = "completa a dupla (quem prova)" if cal["nivel"] == 2 else "nível cravado"
        print(f"   {ia:10} braço={a.braco or ia:10} {PAPEL_PADRAO.get(ia, 'plano geral')}"
              f"  ← {motivo}")
    fora = [x for x in candidatas if x not in alvos]
    if fora:
        print("   de fora:")
        for ia in fora:
            papel = PAPEL_PADRAO.get(ia, "plano geral")
            if cal["origem"] == "ias":
                porque = "--ias não a nomeou"
            elif cal["origem"] == "cravado" and cal["nivel"] == 1:
                porque = "nível 1 pede uma só; não foi a de maior afinidade"
            elif cal["origem"] == "cravado" and cal["nivel"] == 2:
                porque = "nível 2 já tem a frente e quem prova"
            elif ia not in AFINIDADE:
                porque = "sem vocação cadastrada neste comando"
            elif ia not in {c["ia"] for c in cal["casadas"]}:
                porque = f"vocação ({papel}) não casou com o enunciado"
            else:
                porque = "o nível estimado não a pediu"
            print(f"   - {ia}: {porque}")
    if cal["recusadas"]:
        print("   recusadas (dono e brain nunca operam o plano): "
              + ", ".join(cal["recusadas"]))


def cmd_plan(a) -> int:
    e = le_estado()
    if not e or not e.get("goal"):
        print("✗ não há objetivo. `iachat-comando goal \"...\"` primeiro — o `/plan` "
              "planeja o enunciado, e sem enunciado ele planejaria o quê?", file=sys.stderr)
        return 2

    if a.colher:
        return colher(e, a)

    vivos = [i for i, w in e.get("workers", {}).items() if vivo(w, e["id"])]
    if vivos and not a.forcar:
        print(f"✗ {len(vivos)} worker(s) ainda planejando: {', '.join(vivos)}.\n"
              f"  `iachat-comando quem` mostra o estado · `--forcar` dispara por cima.",
              file=sys.stderr)
        return 3

    candidatas, _brain, _dono = sala_operaria()
    ias_cli = [core.normaliza_ia(x) for p in (getattr(a, "ias", None) or [])
               for x in p.split(",") if x]
    nivel = getattr(a, "nivel", None)
    if isinstance(nivel, str) and nivel.strip().isdigit():
        nivel = int(nivel)
    cal = calibra_plan(
        e["goal"], candidatas,
        ias=ias_cli or None,
        nivel=nivel if nivel in (1, 2, 3) else None,
        todas=bool(getattr(a, "todas", False)),
        brain=_brain,
    )
    alvos = cal["alvos"]
    if not alvos:
        print(f"✗ nenhuma IA para planejar (sala={sala()}, brain e dono fora). "
              f"Use `--ias codex,kimi`.", file=sys.stderr)
        return 2

    if a.seco:
        imprime_calibracao(cal, candidatas, e, a)
        return 0

    e["workers"] = e.get("workers", {})
    print(f"📐 {e['id']} · {cal['criterio']} · pedindo plano a {len(alvos)} IA(s)")
    for ia in alvos:
        papel = PAPEL_PADRAO.get(ia, "o plano do seu ângulo")
        w = despacha(ia, a.braco or ia, e, papel)
        e["workers"][ia] = w
        print(f"   {ia:10} pid {w['pid']:>6}  {w['braco']:10} {papel}")
    e["estado"] = "planejando"
    grava_estado(e)

    if a.esperar:
        return espera(e, a)
    print(f"\n   colher: `iachat-comando plan --colher`   ·   parar: `iachat-comando parar`")
    return 0


def espera(e: dict, a) -> int:
    fim = time.time() + a.esperar
    while time.time() < fim:
        e2 = le_estado() or e
        faltam = [i for i, w in e2["workers"].items()
                  if not Path(w["plano"]).exists() and vivo(w, e2["id"])]
        if not faltam:
            break
        time.sleep(3)
    return colher(le_estado() or e, a)


def colher(e: dict, a) -> int:
    """Lê, confronta e devolve RESUMO à sala; os corpos ficam só no disco."""
    ws = e.get("workers", {})
    if not ws:
        print("✗ nada despachado nesta missão. `iachat-comando plan` primeiro.", file=sys.stderr)
        return 2

    entregues, vazios = [], []
    for ia, w in ws.items():
        p = Path(w["plano"])
        if p.exists() and p.stat().st_size > 0:
            w["estado"] = "entregue"
            texto = p.read_text(encoding="utf-8", errors="replace")
            entregues.append((ia, p, p.stat().st_size, texto))
        else:
            v, motivo = confere_dono(w, e["id"])
            w["estado"] = "rodando" if v == "ok" else "morto"
            vazios.append((ia, w["estado"], motivo))

    dados, problemas = {}, {}
    for ia, _p, _n, texto in entregues:
        contrato, motivo = _le_contrato_confronto(texto, e["id"])
        if contrato:
            dados[ia] = contrato
        else:
            problemas[ia] = motivo
    for ia, _est, motivo in vazios:
        problemas[ia] = "plano não entregue: " + motivo

    linhas = [f"**Planos da missão {e['id']}** — objetivo: {e['goal']}", ""]
    for ia, p, n, _texto in entregues:
        linhas.append(f"- **{ia}** · {n} B · `{p}`")
        if ia in dados:
            c = dados[ia]["campos"]
            linhas.append(
                f"  > Veredito {ia}: recomendacao={c['recomendacao']} · "
                f"aplicar_agora={c['aplicar_agora']} · tamanho={c['tamanho']}"
            )
        else:
            linhas.append(f"  > Veredito não comparável: plano de {ia}; {problemas[ia]}")
    for ia, est, motivo in vazios:
        linhas.append(f"- **{ia}** · sem plano ({est}: {motivo})")
    linhas += [""] + _confronta_planos(dados, len(ws), problemas)
    # O caminho + contrato curto, nunca primeiras linhas arbitrárias nem o plano
    # inteiro: a sala cobra de TODA IA que a lê, toda vez (core.AVISO_GRANDE).
    linhas += ["", "Planos completos nos caminhos acima — a sala leva o resumo, não o corpo.",
               "Autorizar: `iachat-comando concluir --para <ia>`."]
    corpo = "\n".join(linhas)

    e["estado"] = "planejada" if entregues else "planejando"
    grava_estado(e)

    print(corpo)
    if not a.calado:
        # Assina quem ABRIU a missão (`cmd_goal` grava `"de"`), não quem rodou o colher.
        # O fallback é o brain, não o dono: estado sem `"de"` significa que não sabemos
        # quem abriu — e "não sei" nunca deve virar "foi ele". Um estado assim só existe
        # se foi gravado por uma versão anterior ao campo.
        r = anuncia(e.get("de") or core.config().get("brain", DONO), corpo, ["all"])
        if r:
            print(f"\n↪ na sala como #{r['n']}")
    if not entregues:
        print("\n✗ nenhum plano no disco — nada a autorizar.", file=sys.stderr)
        return 1
    return 0


# ---------------------------------------------------------------- /concluir
def cmd_concluir(a) -> int:
    e = le_estado()
    if not e:
        print("✗ não há missão. `iachat-comando goal \"...\"` primeiro.", file=sys.stderr)
        return 2

    prontos = [ia for ia, w in e.get("workers", {}).items()
               if Path(w["plano"]).exists() and Path(w["plano"]).stat().st_size > 0]
    if not prontos and not a.forcar:
        print("✗ não há plano no disco para autorizar. Autorizar o vazio é assinar em "
              "branco — `iachat-comando plan` primeiro (`--forcar` assume o risco).",
              file=sys.stderr)
        return 3

    alvo = [core.normaliza_ia(x) for x in (a.para or [])] or prontos
    texto = " ".join(a.texto).strip()
    e["estado"] = "autorizada"
    e["autorizado"] = {"em": core.agora(), "por": core.normaliza_ia(autor(a)),
                       "para": alvo, "nota": texto}
    grava_estado(e)

    corpo = (
        f"✅ **AUTORIZADO — missão {e['id']}**\n\n"
        f"Objetivo: {e['goal']}\n\n"
        f"Autorizado a aplicar: {', '.join('@' + x for x in alvo) or '(ninguém nomeado)'}\n"
        + (f"\n{texto}\n" if texto else "")
        + f"\nPlanos: {Path(e['dir']) / 'planos'}\n"
        f"Isto é a única etapa que muda o mundo. O que não estiver no plano autorizado "
        f"continua não autorizado."
    )
    print(corpo)
    if not a.calado:
        r = anuncia(autor(a), corpo, alvo or ["all"])
        if r:
            print(f"\n↪ na sala como #{r['n']} → {', '.join(r['para']) or 'ninguém'}")
    return 0


# ---------------------------------------------------------------- /parar
def parar_run(a) -> int:
    """Aborta worker(s) de um run do iaswarm, matando a descendência por ppid.

    Só mata quem o disco PROVA ser daquele run. `nao-verificavel` é recusa, nunca
    chute: o run não guarda o instante de nascimento, então quando a prova derivada
    não fecha, o desfecho seguro é deixar vivo e dizer por quê.
    """
    try:
        r = le_run(Path(a.run))
    except ValueError as e:
        print(f"✗ {e}", file=sys.stderr)
        return 2
    ws = r["workers"]

    pedidos = [x for p in (a.ia or []) for x in p.split(",") if x]
    desconhecidos = [x for x in pedidos if x not in ws]
    if desconhecidos:
        print(f"✗ não estão neste run: {', '.join(desconhecidos)} (há: {', '.join(ws)})",
              file=sys.stderr)
        return 2
    alvos = pedidos or list(ws)

    sig = signal.SIGKILL if a.forte else signal.SIGTERM
    tabela = _tabela_ps()
    mortos, recusados, ja = [], [], []
    for w in alvos:
        i = ws[w]
        if i["veredito"] == "morto":
            ja.append(w)
            print(f"   {w:16} já não estava rodando ({i['motivo']})")
            continue
        if i["veredito"] != "vivo":
            recusados.append((w, i["motivo"]))
            print(f"   {w:16} ⛔ NÃO MATEI — {i['motivo']}", file=sys.stderr)
            continue
        pid = i["pid"]
        arvore = descendentes(pid, tabela) + [pid]   # folhas primeiro, raiz por último
        atingidos = _sinaliza(arvore, sig)
        # SIGTERM é pedido, não ordem: `bash` esperando em `wait` recebe o sinal e só
        # sai quando o `wait` retorna — medido em 18/08, o shell continuou de pé com o
        # filho já morto. Um `parar` que anuncia "parado" para quem ficou de pé é o
        # mesmo defeito do painel que este comando existe para denunciar.
        sobreviventes = _insiste(arvore, a.espera)
        mortos.append(w)
        print(f"   {w:16} {sig.name} em {len(atingidos)} processo(s): "
              f"{', '.join(str(x) for x in atingidos)}")
        if sobreviventes:
            print(f"   {'':16} ↳ SIGKILL nos {len(sobreviventes)} que ignoraram o "
                  f"{sig.name}: {', '.join(str(x) for x in sobreviventes)}")
        restam = [x for x in arvore if esta_vivo(x)]
        if restam:
            recusados.append((w, f"AINDA DE PÉ após SIGKILL: {restam}"))
            print(f"   {w:16} ⚠️  ainda de pé: {restam}", file=sys.stderr)

    print(f"\n🛑 {len(mortos)} parado(s) · {len(ja)} já morto(s) · {len(recusados)} recusado(s)")
    print(f"   (nada foi escrito em {r['dir']} — o run é de outro programa)")
    if recusados:
        print("✗ recusa é o desfecho seguro: sem prova de que o PID é daquele worker, "
              "matar é apostar.", file=sys.stderr)
        return 3
    return 0


def cmd_parar(a) -> int:
    if a.run:
        if a.seco:
            # Um run se prevê com o instrumento de presença, que é read-only: matar
            # lá tem as mesmas travas daqui, e a previsão é a mesma leitura do ps.
            print("✗ --seco é só para a missão corrente; um run se prevê com "
                  "`iachat-comando quem --run <dir>`.", file=sys.stderr)
            return 2
        return parar_run(a)
    e = le_estado()
    if not e:
        print("✗ não há missão para parar.", file=sys.stderr)
        return 2
    ws = e.get("workers", {})
    if not ws:
        print("✗ a missão não despachou ninguém — não há o que parar.", file=sys.stderr)
        return 2

    pedidos = [core.normaliza_ia(x) for p in (a.ia or []) for x in p.split(",") if x]
    desconhecidos = [x for x in pedidos if x not in ws]
    if desconhecidos:
        print(f"✗ não estão nesta missão: {', '.join(desconhecidos)} "
              f"(há: {', '.join(ws)})", file=sys.stderr)
        return 2
    alvos = pedidos or list(ws)

    if a.seco:
        # Previsão sem efeito colateral: os MESMOS veredictos que o disparo usaria,
        # mas ninguém morre, nada se grava, nada se anuncia. É o que a interface
        # mostra ANTES de pedir a confirmação do dono. A previsão não congela o
        # mundo: entre ela e o ato há uma pausa humana — um PID pode ser reciclado
        # nesse intervalo —, e é por isso que no instante do kill o `confere_dono`
        # roda DE NOVO. O seco mostra o presente; a prova vale é na hora.
        print(f"🧪 seco — missão {e['id']}: o que o disparo faria")
        for ia in alvos:
            w = ws[ia]
            veredito, motivo = confere_dono(w, e["id"])
            if veredito == "ok":
                try:
                    grupo = os.getpgid(w["pid"]) == w["pid"]
                except OSError:
                    grupo = False
                escopo = "o grupo inteiro" if grupo else "só o processo"
                print(f"   {ia:10} pid {w['pid']:>6}  {w.get('papel', '')} "
                      f"— pararia {escopo}")
            elif veredito == "morto":
                print(f"   {ia:10} já não está rodando ({motivo})")
            else:
                print(f"   {ia:10} ⛔ NÃO seria parado — {motivo}")
        return 0

    sig = signal.SIGKILL if a.forte else signal.SIGTERM
    mortos, recusados, ja = [], [], []
    for ia in alvos:
        w = ws[ia]
        veredito, motivo = confere_dono(w, e["id"])
        if veredito == "morto":
            w["estado"] = "morto"
            ja.append(ia)
            print(f"   {ia:10} já não estava rodando ({motivo})")
            continue
        if veredito == "recusado":
            recusados.append((ia, motivo))
            print(f"   {ia:10} ⛔ NÃO MATEI — {motivo}", file=sys.stderr)
            continue
        alvo_str = mata(w["pid"], sig)
        if alvo_str.startswith("erro"):
            recusados.append((ia, alvo_str))
            print(f"   {ia:10} ⛔ {alvo_str}", file=sys.stderr)
            continue
        w["estado"] = "parado"
        w["parado_em"] = core.agora()
        mortos.append(ia)
        print(f"   {ia:10} pid {w['pid']} ({alvo_str}) ← {sig.name}")

    # SIGTERM é pedido, não ordem — e um `parar` que anuncia "parado" para quem
    # continua de pé mente igual ao painel. Confere e escala.
    if mortos and not a.forte:
        teimosos = _insiste([ws[ia]["pid"] for ia in mortos], a.espera)
        if teimosos:
            print(f"   ↳ SIGKILL nos que ignoraram o SIGTERM: "
                  f"{', '.join(str(x) for x in teimosos)}")
        restam = [ia for ia in mortos if esta_vivo(ws[ia]["pid"])]
        if restam:
            print(f"⚠️  AINDA de pé após SIGKILL: {', '.join(restam)}", file=sys.stderr)
            recusados += [(ia, "sobreviveu ao SIGKILL") for ia in restam]

    e["estado"] = "parada" if not any(
        vivo(w, e["id"]) for w in ws.values()) else e.get("estado", "planejando")
    grava_estado(e)

    print(f"\n🛑 {len(mortos)} parado(s) · {len(ja)} já morto(s) · {len(recusados)} recusado(s)")
    if not a.calado and mortos:
        anuncia(autor(a), f"🛑 **Missão {e['id']} abortada pelo dono.** Parados: "
                      f"{', '.join(mortos)}. Quem estava planejando, pare — o plano "
                      f"incompleto no disco não vale como entrega.", ["all"])
    if recusados:
        print("✗ recusa é o desfecho seguro: matar PID que não é do worker é pior do "
              "que não parar.", file=sys.stderr)
        return 3
    return 0


# ---------------------------------------------------------------- /quem
MARCA_VEREDITO = {"vivo": "🟢 vivo", "morto": "🔴 morto",
                  "nao-verificavel": "🟡 não-verificável"}


def quem_run(a) -> int:
    """Presença sobre um run do iaswarm. TRÊS desfechos, nunca dois.

    Fundir "não consegui verificar" com "morto" ou com "vivo" é a mentira que este
    comando existe para não contar: em 18/08 o `state.json` de um run dizia `rodando`
    para seis workers cujos PIDs já não existiam no `ps`.
    """
    try:
        r = le_run(Path(a.run))
    except ValueError as e:
        print(f"✗ {e}", file=sys.stderr)
        return 2

    ws = r["workers"]
    if a.json:
        print(json.dumps({
            "run": str(r["dir"]),
            "workers": [{"worker": w, **{k: (str(v) if isinstance(v, (datetime, Path)) else v)
                                         for k, v in i.items()}} for w, i in ws.items()],
            "orfaos": [{"pid": p, "cmd": c} for p, c in r["orfaos"]],
        }, ensure_ascii=False, indent=2))
        return 0

    conta = {k: sum(1 for i in ws.values() if i["veredito"] == k)
             for k in ("vivo", "morto", "nao-verificavel")}
    print(f"🐝 {r['dir']}")
    print(f"   {conta['vivo']} vivo(s) · {conta['morto']} morto(s) · "
          f"{conta['nao-verificavel']} não-verificável(is) · {len(ws)} no workers.tsv")
    print()
    print(f"{'worker':16} {'braço':10} {'veredito':18} {'pid':>7}  {'entregue':8} porquê")
    for w, i in ws.items():
        print(f"{w:16} {i['braco']:10} {MARCA_VEREDITO[i['veredito']]:18} "
              f"{str(i.get('pid') or '—'):>7}  {'✅' if i['entregue'] else '—':8} "
              f"{i['motivo']}")

    if r["orfaos"]:
        print(f"\n⚠️  {len(r['orfaos'])} processo(s) VIVO(s) citando este run e SEM `.pid` "
              f"registrado — ausência de `.pid` não prova morte:")
        for p, c in r["orfaos"]:
            print(f"   pid {p}: {c[:100]}")

    # O painel é outro instrumento; quando ele diverge do `ps`, o réu é o painel.
    sj = r["dir"] / "state.json"
    if sj.is_file():
        try:
            dados = json.loads(sj.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            dados = {}
        divergem = [
            (x["worker"], x["estado"], ws[x["worker"]]["veredito"])
            for x in dados.get("workers", [])
            if x.get("worker") in ws
            and x.get("estado") in ("rodando", "despachado")
            and ws[x["worker"]]["veredito"] != "vivo"
        ]
        if divergem:
            print(f"\n⚠️  state.json diz que {len(divergem)} ainda anda(m), e o `ps` não confirma:")
            for w, painel, real in divergem:
                print(f"   {w:16} painel={painel:12} ps={real}")
    return 0


def cmd_quem(a) -> int:
    if a.run:
        return quem_run(a)
    e = le_estado()
    cfg = core.config()
    brain = core.normaliza_ia(cfg.get("brain", ""))
    linhas = []
    # Quem está na sala MAIS quem está trabalhando na missão. Antes o laço percorria só
    # `na_sala`, e um worker despachado para braço de fora — `qwen`, `grok`, `agy`, que
    # planejam sem morar na sala — ficava INVISÍVEL no comando cuja única função é dizer
    # quem está vivo. Medido em 18/08 na missão m2: `qwen` rodando com pid 34029 e
    # ausente da listagem. Quem olha um painel que esconde metade da frota conclui que
    # ela morreu e redispara em cima de trabalho vivo.
    trabalhando = [ia for ia in (e or {}).get("workers", {}) if ia not in sala()]
    for ia in sala() + trabalhando:
        c = core.p_cursor(ia)
        try:
            em = json.loads(c.read_text(encoding="utf-8")).get("em")
        except (OSError, ValueError, json.JSONDecodeError):
            em = None
        pend = core.p_pendente(ia)
        n_pend = len([ln for ln in pend.read_text(encoding="utf-8").splitlines()
                      if ln.startswith("- **#")]) if pend.exists() else 0
        w = (e or {}).get("workers", {}).get(ia)
        if w:
            veredito, motivo = confere_dono(w, e["id"])
            tem_plano = Path(w["plano"]).exists() and Path(w["plano"]).stat().st_size > 0
            if veredito == "ok":
                fazendo = f"planejando ({w['papel']})"
                estado = f"🟢 pid {w['pid']}"
            elif tem_plano:
                fazendo = "plano entregue"
                estado = "✅"
            else:
                fazendo = f"caiu sem entregar — {motivo}"
                estado = "🔴"
            # `.get`, não `w["inicio"]`: um worker com estado parcial derrubava o
            # comando inteiro com KeyError. `/quem` é a ferramenta de DIAGNÓSTICO —
            # quem a chama já está tentando entender algo que deu errado, e um
            # traceback ali tira a única visão que resta. Falta de um campo vira
            # coluna vazia; nunca tela preta.
            quando = desde(w.get("inicio"))
        else:
            fazendo = "—"
            estado = "⚪ fora da missão"
            quando = ""
        linhas.append({
            "ia": ia, "brain": ia == brain, "estado": estado, "fazendo": fazendo,
            "ha": quando, "leu": desde(em), "pendentes": n_pend,
        })

    if a.json:
        print(json.dumps({"missao": (e or {}).get("id"), "estado": (e or {}).get("estado"),
                          "quem": linhas}, ensure_ascii=False, indent=2))
        return 0

    if e:
        print(f"🎯 {e['id']} · {e['estado']} · {desde(e['criado'])} · {e['goal'][:80]}")
    else:
        print("🎯 nenhuma missão aberta")
    print()
    print(f"{'ia':10} {'estado':14} {'há':>8}  {'leu a sala':>11}  o que está fazendo")
    for L in linhas:
        marca = "🧠" if L["brain"] else "  "
        sino = f" · {L['pendentes']} chamado(s)" if L["pendentes"] else ""
        print(f"{marca}{L['ia']:8} {L['estado']:14} {L['ha']:>8}  {L['leu']:>11}  "
              f"{L['fazendo']}{sino}")
    return 0


# ---------------------------------------------------------------- /refaz
def refaz_run(a) -> int:
    """Redispara um worker morto de um run do iaswarm, retomando o parcial.

    O prompt é o PROTOCOLO IASWARM literal (dispatch.sh:27-34), porque é o que a frota
    já sabe cumprir; o que se acrescenta é a retomada. Escreve só `logs/<w>.{pid,log,
    prompt}` — o `resultados/<w>.md` quem escreve é o worker.
    """
    try:
        r = le_run(Path(a.run))
    except ValueError as e:
        print(f"✗ {e}", file=sys.stderr)
        return 2
    d, ws = r["dir"], r["workers"]
    w = a.ia
    if w not in ws:
        print(f"✗ '{w}' não está neste run (há: {', '.join(ws)})", file=sys.stderr)
        return 2
    i = ws[w]

    if i["veredito"] == "vivo" and not a.forcar:
        print(f"✗ {w} ainda está VIVO (pid {i['pid']}). Redisparar agora daria dois "
              f"workers escrevendo o mesmo resultado.\n"
              f"  `iachat-comando parar --run {d} --ia {w}` antes, ou `--forcar`.",
              file=sys.stderr)
        return 3
    if i["veredito"] == "nao-verificavel" and not a.forcar:
        print(f"✗ não consigo provar que {w} morreu: {i['motivo']}.\n"
              f"  Redisparar sobre um worker que talvez esteja vivo duplica trabalho e "
              f"gasta assinatura. `--forcar` assume o risco.", file=sys.stderr)
        return 3
    if i["entregue"] and not a.forcar:
        print(f"✗ {w} já entregou {i['resultado']}. Redisparar apagaria trabalho pronto "
              f"— `--forcar` se for de propósito.", file=sys.stderr)
        return 3

    contrato = i["contrato"] or f"contratos/{w}.md"
    n = i["etapas"]
    protocolo = (
        f"PROTOCOLO IASWARM. Leia e cumpra o contrato em {d}/{contrato} até o fim, sem "
        f"perguntar. Após CADA etapa concluída, appenda 1 linha no arquivo "
        f"{d}/progress/{w}.jsonl no formato "
        f'{{"etapa":K,"de":{n},"estado":"rodando","nota":"3-8 palavras"}}. '
        f"Escreva o resultado final em {d}/resultados/{w}.md no formato "
        f"'missão:'/'resultado:'. Fronteira de escrita: SOMENTE os caminhos citados no "
        f"contrato + progress/resultado acima."
    )

    parcial = ""
    log = d / "logs" / f"{w}.log"
    res = Path(i["resultado"])
    if res.is_file() and res.stat().st_size > 0:
        parcial = res.read_text(encoding="utf-8", errors="replace")[-2000:]
    elif log.is_file():
        parcial = log.read_text(encoding="utf-8", errors="replace")[-1500:]
    if parcial:
        protocolo += (f"\n\nRETOMADA: você já tinha produzido isto antes de cair. "
                      f"Continue de onde parou, não recomece do zero:\n\n{parcial}")

    tentativa = 2
    while (d / "logs" / f"{w}.r{tentativa}.prompt.txt").exists():
        tentativa += 1
    pr = d / "logs" / f"{w}.r{tentativa}.prompt.txt"
    novo_log = d / "logs" / f"{w}.r{tentativa}.log"

    if a.seco:
        # Seco não escreve NADA: o run é dado de outro programa, e uma simulação que
        # deixa arquivo no diretório alheio não é simulação.
        print(f"🧪 seco — {w} seria redisparado no braço {a.braco or i['braco']}")
        print(f"   prompt de {len(protocolo)} B iria para {pr}")
        print(f"   {'retomando ' + str(len(parcial)) + ' B de parcial' if parcial else 'do zero'}")
        return 0
    pr.write_text(protocolo, encoding="utf-8")

    despachante = os.environ.get("IACHAT_DESPACHO", str(DESPACHO_PADRAO))
    # A marca vai sem barras: o adaptador da kimi usa este campo como nome de sessão
    # tmux, e tmux trata `:` e `/` como separador. O ÂNCORA de identidade não é ela —
    # é o caminho do prompt, que fica dentro do run e aparece na linha de comando.
    marca = f"{d.name}-{w}"
    p = subprocess.Popen(
        [despachante, a.braco or i["braco"], marca, str(pr), str(novo_log), str(res)],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
        start_new_session=True, cwd=str(d),
    )
    (d / "logs" / f"{w}.pid").write_text(f"{p.pid}\n", encoding="utf-8")
    print(f"♻️  {w} redisparado · pid {p.pid} · braço {a.braco or i['braco']} · "
          f"tentativa r{tentativa}"
          f"{' · retomando ' + str(len(parcial)) + ' B' if parcial else ' · do zero'}")
    print(f"   log {novo_log}")
    return 0


def cmd_refaz(a) -> int:
    if a.run:
        return refaz_run(a)
    e = le_estado()
    if not e:
        print("✗ não há missão.", file=sys.stderr)
        return 2
    # `--ia` deixou de ser `required=True` no argparse porque via `--via-app` ele
    # chega pelo JSON do stdin DEPOIS do parse. A validação mora aqui, no mesmo
    # lugar para os dois caminhos.
    if not a.ia or not str(a.ia).strip():
        print("✗ diga qual IA: `iachat-comando refaz --ia <ia>`.", file=sys.stderr)
        return 2
    ia = core.normaliza_ia(a.ia)
    w = e.get("workers", {}).get(ia)
    if not w:
        print(f"✗ '{ia}' não está nesta missão (há: {', '.join(e.get('workers', {})) or 'ninguém'})",
              file=sys.stderr)
        return 2

    veredito, motivo = confere_dono(w, e["id"])
    if veredito == "ok" and not a.forcar:
        print(f"✗ {ia} ainda está VIVO (pid {w['pid']}, {desde(w['inicio'])}). Redisparar "
              f"agora daria dois workers escrevendo no mesmo plano.\n"
              f"  `iachat-comando parar --ia {ia}` antes, ou `--forcar` (para e redispara).",
              file=sys.stderr)
        return 3
    if veredito == "ok" and a.forcar:
        r = mata(w["pid"], signal.SIGTERM)
        print(f"   {ia} pid {w['pid']} ({r}) ← SIGTERM antes de redisparar")
        time.sleep(2)

    plano = Path(w["plano"])
    parcial = ""
    if plano.exists() and plano.stat().st_size > 0:
        if not a.forcar:
            print(f"✗ {ia} já entregou plano ({plano.stat().st_size} B em {plano}). "
                  f"Redisparar apagaria trabalho pronto — `--forcar` se for de propósito.",
                  file=sys.stderr)
            return 3
        parcial = plano.read_text(encoding="utf-8", errors="replace")[-2000:]
        if not a.seco:   # seco não move arquivo: simulação que mexe no disco não simula
            plano.rename(plano.with_suffix(f".parcial{w.get('tentativas', 1)}.md"))
    elif Path(w["log"]).exists():
        # Sem plano no disco, o log é o que sobrou do que ele pensou.
        parcial = Path(w["log"]).read_text(encoding="utf-8", errors="replace")[-1500:]

    if a.seco:
        print(f"🧪 seco — {ia} seria redisparado no braço {a.braco or w['braco']}")
        print(f"   {'retomando ' + str(len(parcial)) + ' B de parcial' if parcial else 'do zero'}")
        return 0

    novo = despacha(ia, a.braco or w["braco"], e, w["papel"], parcial)
    novo["tentativas"] = w.get("tentativas", 1) + 1
    e["workers"][ia] = novo
    e["estado"] = "planejando"
    grava_estado(e)
    print(f"♻️  {ia} redisparado · pid {novo['pid']} · tentativa {novo['tentativas']}"
          f"{' · retomando ' + str(len(parcial)) + ' B do parcial' if parcial else ' · do zero'}")
    return 0


# ---------------------------------------------------------------- /decidi
def cmd_decidi(a) -> int:
    """Delega ao `iachat-decide` E anuncia na sala com o marcador `DECIDIDO:`.

    Há DOIS instrumentos de decisão nesta casa, e eles não se enxergavam:

      · `decisoes.md`, escrito pelo `iachat-decide` — registro durável, com revogação
        gravada no arquivo;
      · a linha `DECIDIDO:` dentro de uma mensagem do chat, que o `iachat-report` lê
        pelo `RE_MARCA` (iachat-report:28-31) e mostra no relatório do dono.

    Medido em 18/08: a sala real tinha CINCO decisões `DECIDIDO:` (iachat.md:376, 378,
    380, 382, 413) e `decisoes.md` NÃO EXISTIA. O registro estava vazio e o que valia
    de fato só existia como texto no chat. Mandar o `/decidi` alimentar só um dos dois
    seria escolher qual metade da casa fica desatualizada.

    Então um ato só alimenta os dois: grava no registro (sem duplicar a lógica dele) e
    posta na sala uma mensagem cuja primeira linha é `DECIDIDO: …`.
    """
    if not DECIDE.is_file():
        print(f"✗ {DECIDE} não existe — o registro de decisões é dele, não deste comando.",
              file=sys.stderr)
        return 2
    de = core.normaliza_ia(autor(a))
    texto = " ".join(a.texto).strip()

    # O `--anunciar` do iachat-decide chama core.post(de,…), que exige `de` na sala
    # (iachat_core.py:258-262): com `--de bauer` seria traceback. O anúncio é feito
    # aqui, por `voz()`, que sabe fazer o dono falar pela orquestradora.
    argv = [sys.executable, str(DECIDE), "decidir", "--de", de]
    for flag, val in (("--porque", a.porque), ("--sobre", a.sobre)):
        if val:
            argv += [flag, val]
    for r in a.revoga or []:
        argv += ["--revoga", r]
    argv += list(a.texto)
    r = subprocess.run(argv, text=True, capture_output=True)
    sys.stdout.write(r.stdout)
    sys.stderr.write(r.stderr)
    if r.returncode != 0:
        return r.returncode

    if not a.calado:
        marca = f"DECIDIDO: {texto}"
        corpo = (f"{marca}\n\nPorque: {a.porque.strip()}\n\n"
                 f"Assunto: {a.sobre or 'geral'} · registro durável: "
                 f"`iachat-decide decisoes`")
        alvo = [a.anunciar] if a.anunciar else ["all"]
        post = anuncia(de, corpo, alvo)
        if post:
            print(f"  ↪ anunciada na sala como #{post['n']} → "
                  f"{', '.join(post['para']) or 'ninguém'} (com marcador DECIDIDO:, "
                  f"que o `iachat-report` lê)")
    return 0


# ---------------------------------------------------------------- interface (app)
# O que atravessa o stdin de cada comando quando chamado pela interface.
# Chave → (tipo, obrigatória). O mapa é a ALLOWLIST do payload: chave fora dele é
# RECUSADA, nunca vira argumento. Foi assim que a tentativa de contrabandear
# `forcar`/`forte`/`--forte` pelo JSON morreu na borda, no gate, sem chegar perto
# do despacho (teste_comandos_ui.py prova o caso que reprova).
VIA_APP = {
    "goal": {"texto": (str, True)},
    "plan": {"seco": (bool, False), "colher": (bool, False),
             "ias": (list, False), "nivel": (int, False), "todas": (bool, False)},
    "concluir": {"texto": (str, False), "para": (list, False)},
    "parar": {"seco": (bool, False)},
    "refaz": {"ia": (str, True), "seco": (bool, False)},
    "decidi": {"texto": (str, True), "porque": (str, True),
               "sobre": (str, False), "revoga": (list, False)},
}


def le_via_app(a) -> None:
    """Lê o objeto JSON que o servidor da interface manda pelo stdin.

    O argv que chegou até aqui é CONSTANTE (allowlist de `ui/servir.py`); tudo o
    que é variável — o enunciado do `/goal`, a IA do `/refaz`, o motivo do
    `/decidi` — entra por aqui, validado chave a chave. É a fronteira onde
    "linha de comando montada com texto do usuário" deixa de ser possível:
    texto vira dado, nunca argumento.

    `texto` merece o único tratamento especial: os comandos o recebem como
    `nargs="*"` e juntam com espaço, então uma string única vira lista de uma.
    """
    try:
        dados = json.load(sys.stdin)
    except (OSError, ValueError) as e:
        raise ValueError(f"--via-app: o stdin não trouxe JSON válido ({e})")
    if not isinstance(dados, dict):
        raise ValueError("--via-app: o payload é UM OBJETO JSON — nada mais")
    mapa = VIA_APP.get(a.cmd)
    if mapa is None:
        raise ValueError(f"--via-app: '{a.cmd}' não atravessa a interface")
    fora = sorted(set(dados) - set(mapa))
    if fora:
        raise ValueError(
            f"--via-app recusa chave(s) fora da allowlist: {', '.join(fora)}. "
            f"Aceitas: {', '.join(mapa)}")
    faltam = [k for k, (_t, obrigatoria) in mapa.items()
              if obrigatoria and not dados.get(k)]
    if faltam:
        raise ValueError(f"--via-app: faltam campos obrigatórios: {', '.join(faltam)}")
    for chave, (tipo, _obrigatoria) in mapa.items():
        if chave not in dados:
            continue
        valor = dados[chave]
        if tipo is list:
            if not isinstance(valor, list) or not all(isinstance(x, str) for x in valor):
                raise ValueError(f"--via-app: `{chave}` é lista de texto")
        elif tipo is str:
            if not isinstance(valor, str) or not valor.strip():
                raise ValueError(f"--via-app: `{chave}` é texto não-vazio")
        elif tipo is int:
            # `nivel` aceita 1|2|3 ou a string equivalente — o JSON do app manda
            # número; quem cola no stdin pode mandar texto. bool é int em Python,
            # então True/False não passam por aqui.
            if isinstance(valor, bool):
                raise ValueError(f"--via-app: `{chave}` é 1, 2 ou 3")
            if isinstance(valor, str) and valor.strip() in {"1", "2", "3"}:
                valor = int(valor)
            elif not isinstance(valor, int):
                raise ValueError(f"--via-app: `{chave}` é 1, 2 ou 3")
            if valor not in (1, 2, 3):
                raise ValueError(f"--via-app: `{chave}` é 1, 2 ou 3")
        elif not isinstance(valor, bool):       # bool por último: True é int também
            raise ValueError(f"--via-app: `{chave}` é true/false")
        if chave == "texto":
            a.texto = [valor]
        else:
            setattr(a, chave, valor)


# ---------------------------------------------------------------- main
def main() -> int:
    ap = argparse.ArgumentParser(prog="iachat-comando", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    def dono(p):
        # default=None (não "bauer") para `resolve_autor` distinguir "ele digitou" de
        # "veio por omissão". O texto de ajuda continua anunciando o padrão real.
        p.add_argument("--de", default=None, help="quem comanda (padrão: bauer)")
        p.add_argument("--calado", action="store_true", help="não postar na sala")
        return p

    def app(p):
        # ESCONDIDA (help=SUPPRESS): quem usa é o servidor da interface
        # (`ui/servir.py`), nunca o dono no terminal. Com ela o comando lê UM
        # OBJETO JSON no stdin (`le_via_app`) em vez de receber o dado variável
        # como argumento — o argv fica sendo a constante da allowlist do servidor.
        p.add_argument("--via-app", action="store_true", help=argparse.SUPPRESS)
        return p

    p = app(dono(sub.add_parser("goal", help="o enunciado: o objetivo que ele explica")))
    p.add_argument("--novo", action="store_true", help="abre missão nova mesmo com worker vivo")
    p.add_argument("texto", nargs="*")
    p.set_defaults(f=cmd_goal)

    p = app(dono(sub.add_parser("plan", help="a frota planeja junta; o tamanho escolhe quantas")))
    p.add_argument("--ias", action="append",
                   help="quem planeja; soberano sobre a estimativa (já existia)")
    p.add_argument("--nivel", type=int, choices=(1, 2, 3),
                   help="crava o nível (1 sozinha, 2 dupla, 3 frota); a estimativa cala")
    p.add_argument("--todas", action="store_true",
                   help="sala menos brain e dono — o comportamento antigo")
    p.add_argument("--braco", help="forçar um braço para todas (codex, kimi, agy…)")
    p.add_argument("--colher", action="store_true", help="ler os planos e devolver na sala")
    p.add_argument("--esperar", type=int, metavar="SEG", help="bloquear até entregarem, e colher")
    p.add_argument("--seco", action="store_true", help="mostrar quem seria despachado, sem gastar")
    p.add_argument("--forcar", action="store_true", help="despachar por cima de worker vivo")
    p.set_defaults(f=cmd_plan)

    p = app(dono(sub.add_parser("concluir", help="autorizado: pode aplicar")))
    p.add_argument("--para", action="append", help="quem fica autorizado a aplicar")
    p.add_argument("--forcar", action="store_true", help="autorizar sem plano no disco")
    p.add_argument("texto", nargs="*", help="a nota da autorização")
    p.set_defaults(f=cmd_concluir)

    p = app(dono(sub.add_parser("parar", help="abortar a missão em andamento")))
    p.add_argument("--ia", action="append", help="só esta(s) (padrão: todas da missão)")
    p.add_argument("--run", help="abortar worker(s) de um run do iaswarm")
    p.add_argument("--forte", action="store_true", help="SIGKILL em vez de SIGTERM")
    p.add_argument("--seco", action="store_true",
                   help="mostrar o que seria parado, sem matar nem gravar nada")
    p.add_argument("--espera", type=float, default=2.0, help="segundos até conferir se saiu")
    p.set_defaults(f=cmd_parar)

    p = sub.add_parser("quem", help="quem está vivo, fazendo o quê, há quanto tempo")
    p.add_argument("--json", action="store_true")
    p.add_argument("--run", help="presença sobre um run do iaswarm (read-only)")
    p.set_defaults(f=cmd_quem)

    p = app(sub.add_parser("refaz", help="redisparar worker morto, de onde parou"))
    # Não é `required=True` no argparse: via `--via-app` o valor chega pelo JSON
    # do stdin depois do parse, e o cmd_refaz valida nos dois caminhos.
    p.add_argument("--ia", help="qual IA (obrigatório)")
    p.add_argument("--run", help="worker de um run do iaswarm")
    p.add_argument("--braco", help="trocar de braço na retomada")
    p.add_argument("--seco", action="store_true", help="mostrar o que faria, sem gastar")
    p.add_argument("--forcar", action="store_true", help="mesmo vivo ou com plano entregue")
    p.set_defaults(f=cmd_refaz)

    p = app(sub.add_parser("decidi", help="registrar decisão que todas obedecem"))
    p.add_argument("--de", default=None)
    p.add_argument("--calado", action="store_true", help="não postar na sala")
    p.add_argument("--porque", help="o motivo — obrigatório (gate do iachat-decide)")
    p.add_argument("--sobre", help="assunto, uma palavra")
    p.add_argument("--revoga", action="append", help="D3 (repetível)")
    p.add_argument("--anunciar", help="também postar na sala, nomeando esta IA")
    p.add_argument("texto", nargs="*")
    p.set_defaults(f=cmd_decidi)

    a = ap.parse_args()
    try:
        if getattr(a, "via_app", False):
            le_via_app(a)          # o JSON do stdin vira argumento, validado na borda
        return a.f(a)
    except ValueError as e:
        print(f"✗ {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
