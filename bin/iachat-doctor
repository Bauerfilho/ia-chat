#!/usr/bin/env python3
"""iachat-doctor — diagnóstico da instalação do ia-chat em todas as cascas.

Read-only por natureza: só lê disco, `ps` e `launchctl list`. Não instala, não
conserta, não escreve na sala. Diagnóstico sem conserto é reclamação, então cada
✗ vem com o passo que corrige — mas quem corrige é o dono, não este script.

TRÊS DESFECHOS, nunca dois:

    ok   ✓  medi e está certo
    ✗       medi e está errado
    ?   ⚠   NÃO CONSEGUI MEDIR

Fundir o terceiro nos outros é a mentira que gerou os três defeitos que este
programa existe para pegar:

  1. skill no disco e no `extra_skill_dirs`, ausente do catálogo da sessão aberta
     (config é lido no boot) — duas medições discordaram e ninguém disse "não sei";
  2. hook instalado que não disparava (config mudou DEPOIS da sessão abrir);
  3. `launchctl list | grep -q` sob `pipefail`: o grep sai no 1º casamento, o pipe
     fecha, o launchctl morre de SIGPIPE (141), o pipeline vira falha e o instalador
     NEGA um daemon que subiu.

Por isso, aqui: nenhum `grep -q`, nenhum pipe. Toda saída de comando externo é
capturada INTEIRA e só depois julgada — e o que não deu para medir sai como `?`.

Uso:
    iachat-doctor                 # as cascas declaradas em config.json:na_sala
    iachat-doctor --todas         # + as cascas conhecidas presentes no disco
    iachat-doctor --casca kimi    # uma só
    iachat-doctor --json          # laudo machine-parseable
    iachat-doctor --repo CAMINHO  # compara o instalado com o repositório-fonte

Saída: 0 se não houver nenhum ✗ (⚠ não reprova — ignorância não é defeito);
1 se houver ✗; 2 se o próprio diagnóstico não pôde começar.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

# ─── contrato do plugin ──────────────────────────────────────────────────────
# LISTA CURTA DEMAIS APROVA INSTALAÇÃO INCOMPLETA — a lição custou duas medições:
# em 17/08, com 7 nomes, o Codex saía ✓ tendo 7 de 9 (faltavam ia-claim e ia-recibo);
# em 18/08, com 9, o doctor conferia 9 de 26 e dizia ✓ igual. A segunda vez mostrou
# que o problema não era o número, e sim o inventário escrito à mão: ele envelhece a
# cada skill nova, e envelhece calado, porque ninguém revisa a lista de um verificador
# que está passando. Por isso `skills_esperadas()` pergunta ao repositório.
#
# O PISO abaixo é só o último recurso — quando o doctor roda instalado, longe do
# repositório que o gerou.
SKILLS_PISO = (
    "ia-chat-activate",
    "ia-bell",
    "ia-nomination",
    "ia-storage",
    "ia-brain",
    "ia-search",
    "ia-chat-consult",
    "ia-claim",
    "ia-recibo",
)


def skills_esperadas() -> tuple[str, ...]:
    """O que o REPOSITÓRIO publica, não uma lista escrita à mão.

    Era uma tupla fixa de 9 nomes, e o repositório já publicava 26 — as outras 17
    podiam estar com frontmatter quebrado, com `name` divergente do diretório, ou
    simplesmente não instaladas, e o doctor dizia ✓ do mesmo jeito. Um inventário
    escrito à mão envelhece na primeira skill nova, e envelhece em silêncio: ninguém
    lembra de atualizar a lista de um verificador que está passando.

    Ler `skills/` do repo faz a checagem crescer sozinha com o produto. Rodando
    instalado (sem o repo ao lado), cai no piso — cobre menos, e é honesto sobre isso.

    Achado do worker `codex` na missão m2.
    """
    # Dois lugares, nesta ordem. O repositório é a fonte; mas o doctor quase sempre roda
    # INSTALADO (`~/.claude/scripts/ia-chat/`), e daí `parent.parent/skills` não existe —
    # a primeira versão desta função caía sempre no piso e o inventário vivo nunca valia.
    # O segundo lugar é onde o `install.sh` deposita tudo: `~/.claude/skills`. Usá-lo
    # como referencial é o que faz o doctor dizer que o Codex tem 9 de 26 em vez de 9/9.
    for origem in (Path(__file__).resolve().parent.parent / "skills",
                   Path(os.path.expanduser("~/.claude/skills"))):
        if not origem.is_dir():
            continue
        achadas = tuple(sorted(d.name for d in origem.iterdir()
                               if d.is_dir() and d.name.startswith("ia-")
                               and (d / "SKILL.md").is_file()))
        if achadas:
            return achadas
    return SKILLS_PISO
# Os 6 arquivos que install.sh:15-16 copia para $DEST_SCRIPTS — o contrato de
# sincronia instalado×repositório. Os CLIs novos que o install.sh AINDA não
# copia (iachat-claim, iachat-recibo, este iachat-doctor) são cobertos pelo
# item `clis-do-repo`, não por este — misturar os dois faria o sync gritar ⚠
# para sempre, sem apontar a causa.
BINARIOS = (
    "iachat",
    "iachat_core.py",
    "ia-bell-daemon.sh",
    "ia-bell-hook.sh",
    "ia-bell-install-daemon.sh",
    "ia-bell-install-hook.py",
)
EVENTOS = ("SessionStart", "UserPromptSubmit")
HOOK = "ia-bell-hook.sh"
RE_MSG = re.compile(rb"<!-- iachat msg=(\d+) ")

# ─── registro de cascas ──────────────────────────────────────────────────────
# Cada campo foi VERIFICADO nesta máquina em 2026-08-17 (e re-verificado na
# implementação, mesmo dia 22:47); a fonte está no comentário.
# `skills`: ("dir", caminho)   — a casca lê o diretório direto
#           ("extra", arquivo) — a casca lê os caminhos de `extra_skill_dirs` do TOML
# `hooks` : ("json", arquivo) | ("toml", arquivo) | None
# `trust` : arquivo onde a casca guarda a aprovação do hook, ou None
CASCAS = {
