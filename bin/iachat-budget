#!/usr/bin/env python3
"""iachat-budget — quem gasta a janela das outras IAs.

A unidade é byte-de-janela, não byte escrito: `len(bruto) × len(para)`.
4 KB para 3 IAs custam 12 KB de janela alheia. Mensagem sem nominação custa
0 de imposto (ninguém é obrigado a lê-la) e ainda conta em `escrito`.

Não há ledger. A conta é leitura derivada do metadado que já existe
(`<!-- iachat msg=N de=X para=Y ts=Z -->`, iachat_core.py:30). Nada é
escrito, nada desincroniza, e o relatório de ontem sobrevive à rotação
porque a varredura cobre os recortes.

    iachat-budget report
    iachat-budget report --dia 2026-08-17 --top 10 --json
    iachat-budget check --de claude --tamanho 4200 --destinos 2
    iachat-budget check --de claude --texto "@codex @kimi resumo em /tmp/x.md"

`check` SEMPRE sai 0, inclusive no vermelho. A sala é o único canal entre
janelas cegas: barrar aqui cria deadlock de comunicação.
"""
from __future__ import annotations

import argparse
import json
import sys
from collections import defaultdict
from datetime import datetime, timedelta
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import iachat_core as core  # noqa: E402

COTA_CHAVE = "cota_diaria_bytes"


def _ler_config() -> dict:
    """Lê config.json SEM criar a sala.

    A proposta da casa usava `core.config()`, que chama `garantir_estrutura()`
    (`iachat_core.py:124`). Instrumento de leitura não pode ter esse efeito.
    """
    try:
        return json.loads(core.p_config().read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return dict(core.CONFIG_PADRAO)


def _cota_diaria(cfg: dict) -> tuple[int, str]:
    if cfg.get(COTA_CHAVE):
        return int(cfg[COTA_CHAVE]), f"config.json:{COTA_CHAVE}"
    teto = int(cfg.get("teto_bytes", core.TETO_PADRAO))
    n = max(1, len(cfg.get("na_sala", [])))
    return teto // n, f"teto_bytes({teto}) ÷ {n} IAs"


def coletar(dias: int | None = None, dia: str | None = None) -> list[dict]:
    """Ativo + recortes, opcionalmente filtrados por data. Sem lock, sem escrita."""
    corte = None
    if dias is not None:
        corte = (datetime.now().astimezone() - timedelta(days=dias)).isoformat()[:10]
    fontes = list(core._recortes())
    if dia or corte:
        limite = dia or corte
        # Nome do recorte carrega a data da rotação (iachat_core.py:468).
        # Recorte fechado ANTES do dia pedido não contém mensagem daquele dia.
        fontes = [p for p in fontes if len(p.stem) >= 17 and p.stem[7:17] >= limite]
    msgs = []
    for p in fontes + [core.p_chat()]:
        try:
            txt = p.read_text(encoding="utf-8")
        except OSError:
            continue
        for m in core.parse(txt):
            d = m["ts"][:10]
            if dia and d != dia:
                continue
            if corte and d < corte:
                continue
            escrito = len(m["bruto"].encode())
            msgs.append(
                {
                    "n": m["n"],
                    "de": m["de"],
                    "para": m["para"],
                    "dia": d,
                    "ts": m["ts"][:16],
                    "escrito": escrito,
                    "imposto": escrito * len(m["para"]),
                }
            )
    return msgs


def contas(msgs: list[dict], sala: list[str]) -> dict:
    """Escrito, imposto e recebido por IA. Saldo = impôs − carregou."""
    por: dict[str, dict] = defaultdict(
        lambda: {"msgs": 0, "escrito": 0, "imposto": 0, "recebido": 0}
    )
    for m in msgs:
        a = por[m["de"]]
        a["msgs"] += 1
        a["escrito"] += m["escrito"]
        a["imposto"] += m["imposto"]
        for d in m["para"]:
            por[d]["recebido"] += m["escrito"]
    for ia in sala:
        por[ia]
    for a in por.values():
        a["saldo"] = a["imposto"] - a["recebido"]
        a["media"] = a["escrito"] // a["msgs"] if a["msgs"] else 0
    return dict(por)


def identidade(msgs: list[dict]) -> bool:
    """Todo byte imposto é byte recebido. Se falhar, o instrumento mente."""
    return sum(m["imposto"] for m in msgs) == sum(
        m["escrito"] * len(m["para"]) for m in msgs
    ) and sum(m["imposto"] for m in msgs) == sum(
        m["escrito"] for m in msgs for _ in m["para"]
    )


def _barra(frac: float, largura: int = 20) -> str:
    cheio = max(0, min(largura, round(frac * largura)))
    return "█" * cheio + "·" * (largura - cheio)


def _destinos_do_texto(texto: str, sala: list[str], autor: str) -> int:
    """Conta quem de fato carregaria a mensagem — sem chutar 1."""
    pedidos = core.extrai_nominados(texto)
    if core.TODOS.lstrip("@") in pedidos or "todos" in pedidos:
        return max(0, len([x for x in sala if x != autor]))
    return len([x for x in dict.fromkeys(pedidos) if x in sala and x != autor])


def cmd_report(a) -> int:
    cfg = _ler_config()
    sala = [core.normaliza_ia(x) for x in cfg.get("na_sala", [])]
    msgs = coletar(dias=a.dias, dia=a.dia)
    if not msgs:
        print("(nenhuma mensagem no período)")
        return 0
    por = contas(msgs, sala)
    cota, origem = _cota_diaria(cfg)
    total_e = sum(x["escrito"] for x in por.values())
    total_i = sum(x["imposto"] for x in por.values())
    dias_vistos = sorted({m["dia"] for m in msgs})

    if a.json:
        print(
            json.dumps(
                {
                    "periodo": dias_vistos,
                    "cota_diaria": cota,
                    "origem_cota": origem,
                    "total_escrito": total_e,
                    "total_imposto": total_i,
                    "identidade_ok": identidade(msgs),
                    "por_ia": por,
                },
                ensure_ascii=False,
                indent=2,
            )
        )
        return 0

    periodo = (
        dias_vistos[0]
        if len(dias_vistos) == 1
        else f"{dias_vistos[0]}…{dias_vistos[-1]}"
    )
    print(f"ia-chat · orçamento · {periodo} · {len(msgs)} mensagens")
    print(f"   cota diária por IA: {cota} B  ({origem})")
    print()
    print("   IA        msgs   escrito     média    IMPOSTO   recebido      saldo")
    print("   ───────────────────────────────────────────────────────────────────")
    for ia, x in sorted(por.items(), key=lambda kv: -kv[1]["imposto"]):
        pct_i = 100 * x["imposto"] / total_i if total_i else 0
        print(
            f"   {ia:<9}{x['msgs']:>5}{x['escrito']:>10}{x['media']:>10}"
            f"{x['imposto']:>11}{x['recebido']:>11}{x['saldo']:>+11}"
            f"   {pct_i:>4.0f}% da janela imposta"
        )
    print("   ───────────────────────────────────────────────────────────────────")
    print(f"   {'TOTAL':<9}{len(msgs):>5}{total_e:>10}{'':>10}{total_i:>11}")
    print()

    print("   cota diária (imposto/dia · o freio avisa, nunca bloqueia)")
    por_dia: dict[str, dict[str, int]] = defaultdict(lambda: defaultdict(int))
    for m in msgs:
        por_dia[m["dia"]][m["de"]] += m["imposto"]
    for d in dias_vistos:
        for ia, v in sorted(por_dia[d].items(), key=lambda kv: -kv[1]):
            frac = v / cota if cota else 0
            sinal = "ok" if frac < 0.8 else ("quase" if frac < 1.0 else "estourou")
            print(
                f"   {d}  {ia:<8} {_barra(frac)} {v:>7} B  {100 * frac:>5.1f}%  {sinal}"
            )
    print()

    caras = sorted(msgs, key=lambda m: -m["imposto"])[: a.top]
    print(
        "   a mensagem mais cara em janela alheia"
        if len(caras) == 1
        else f"   as {len(caras)} mensagens mais caras em janela alheia"
    )
    for m in caras:
        alvo = ",".join(m["para"]) or "—"
        print(
            f"   #{m['n']:<4}{m['de']:<8}→ {alvo:<14}{m['escrito']:>6} B "
            f"×{len(m['para'])} = {m['imposto']:>7} B   {m['ts']}"
        )
    return 0


def cmd_check(a) -> int:
    """Freio informativo. Sempre devolve 0 — nunca impede uma mensagem."""
    cfg = _ler_config()
    ia = core.normaliza_ia(a.de)
    sala = [core.normaliza_ia(x) for x in cfg.get("na_sala", [])]
    cota, origem = _cota_diaria(cfg)
    hoje = datetime.now().astimezone().isoformat()[:10]
    gasto = sum(m["imposto"] for m in coletar(dia=hoje) if m["de"] == ia)

    tamanho = a.tamanho or 0
    destinos = a.destinos
    if a.texto:
        tamanho = len(a.texto.encode())
        if destinos is None:
            destinos = _destinos_do_texto(a.texto, sala, ia)
    if destinos is None:
        destinos = 1
    # Correção da proposta: `max(1, destinos)` mentia para mensagem sem
    # nominação (custa 0 de janela, não 1× o tamanho). 0 é 0.
    projetado = gasto + tamanho * max(0, destinos)
    frac = projetado / cota if cota else 0

    if a.json:
        print(
            json.dumps(
                {
                    "ia": ia,
                    "dia": hoje,
                    "gasto": gasto,
                    "projetado": projetado,
                    "cota": cota,
                    "origem": origem,
                    "fracao": round(frac, 3),
                    "tamanho": tamanho,
                    "destinos": destinos,
                },
                ensure_ascii=False,
            )
        )
        return 0
    if frac >= 1.0:
        print(
            f"estourou {ia} passou a cota do dia: {projetado} B de {cota} B "
            f"({100 * frac:.0f}%) de janela alheia. Grave o detalhe num arquivo "
            f"e poste o RESUMO + o caminho absoluto — a mensagem vai assim mesmo.",
            file=sys.stderr,
        )
    elif frac >= 0.8:
        print(
            f"{ia}: {projetado} B de {cota} B ({100 * frac:.0f}%) da cota do dia.",
            file=sys.stderr,
        )
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(prog="iachat-budget", description=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("report", help="quem gastou quanto de janela alheia")
    p.add_argument("--dias", type=int, help="últimos N dias (padrão: tudo)")
    p.add_argument("--dia", help="um dia só, ISO: 2026-08-17")
    p.add_argument("--top", type=int, default=3, help="quantas mensagens caras listar")
    p.add_argument("--json", action="store_true")
    p.set_defaults(f=cmd_report)

    p = sub.add_parser("check", help="estado da cota de uma IA (nunca bloqueia)")
    p.add_argument("--de", required=True)
    p.add_argument("--tamanho", type=int, default=0, help="bytes da mensagem em curso")
    p.add_argument(
        "--destinos",
        type=int,
        default=None,
        help="quantas IAs vão carregá-la (0 = sem nominação)",
    )
    p.add_argument(
        "--texto",
        default="",
        help="rascunho: infere tamanho e destinos pelos @ da mensagem",
    )
    p.add_argument("--json", action="store_true")
    p.set_defaults(f=cmd_check)

    a = ap.parse_args()
    return a.f(a)


if __name__ == "__main__":
    raise SystemExit(main())
