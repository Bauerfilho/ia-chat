#!/usr/bin/env python3
"""iachat — a porta única de entrada da sala das IAs.

Uma IA nunca escreve no chat com `>>` nem com editor: sem o lock daqui, duas
postando junto perdem mensagem (PIPE_BUF=512 no macOS, e `flock(1)` não existe).
"""
from __future__ import annotations

import argparse
import plistlib
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import iachat_core as core  # noqa: E402


def cmd_post(a) -> int:
    texto = " ".join(a.texto).strip() if a.texto else sys.stdin.read()
    para = [x for p in (a.para or []) for x in p.split(",") if x]
    try:
        r = core.post(a.de, texto, para)
    except ValueError as e:
        print(f"✗ {e}", file=sys.stderr)
        return 2
    alvo = ", ".join(f"@{x}" for x in r["para"]) or "ninguém"
    print(f"✔ #{r['n']} postada por {r['de']} → {alvo}")
    for w in r["avisos"]:
        print(f"⚠️  {w}", file=sys.stderr)
    return 0


def cmd_read(a) -> int:
    escopo = "tudo" if a.tudo else ("todas" if a.todas else "meu")
    r = core.ler(a.de, escopo=escopo, avancar=not a.sem_avancar)
    if not r["msgs"]:
        # "nada" tem DUAS causas com a mesma cara, e a diferença importa: ou ninguém te
        # chamou, ou OUTRA SESSÃO SUA já consumiu. O cursor é por IA, não por sessão —
        # duas janelas do mesmo Claude dividem o mesmo estado de leitura, e a primeira
        # que lê zera o flag da outra (reproduzido pelo enxame em 18/08).
        #
        # A correção NÃO é dar um cursor por sessão: para o dono, duas janelas do Claude
        # são o mesmo Claude, e multiplicar o estado por sessão criaria um isolamento que
        # não existe no modelo mental dele — além de mexer no núcleo, onde um erro já
        # apagou a sala inteira uma vez. O dano real aqui é o consumo ser **silencioso**.
        # Então: mostrar QUANDO a última leitura aconteceu. Se foi há segundos e você não
        # a viu, foi a sua outra janela — e agora dá para saber, em vez de adivinhar.
        quando = ""
        try:
            import datetime as _dt
            import json as _json

            marca = _json.loads(core.p_cursor(a.de).read_text()).get("em", "")
            if marca:
                delta = (_dt.datetime.now().astimezone()
                         - _dt.datetime.fromisoformat(marca)).total_seconds()
                if delta < 300:
                    quando = (f" · lido há {int(delta)}s — se não foi você, "
                              f"foi outra sessão sua: o cursor é por IA, não por janela")
                else:
                    quando = f" · última leitura em {marca[11:16]}"
        except Exception:
            pass          # sem cursor ainda, ou formato antigo: o aviso é opcional
        print(f"(nada para {a.de} — cursor em #{r['desde']} de {r['total']} na sala{quando})")
        return 0
    print(f"📬 {len(r['msgs'])} mensagem(ns) para {a.de} · {r['bytes']} B "
          f"de {r['bytes_sala']} B na sala\n")
    for m in r["msgs"]:
        print(m["bruto"])
    if r["ocultas"]:
        print(f"— {r['ocultas']} mensagem(ns) entre outras IAs ficaram ocultas. "
              f"`iachat read --de {a.de} --tudo` abre a sala; `iachat search \"termo\"` procura.")
    return 0


def cmd_entregar(a) -> int:
    """Saída para HOOK: entrega a mensagem no contexto da IA, sem ela pedir.

    Com teto: acima dele, entrega só os cabeçalhos e NÃO consome o cursor nem o flag —
    entregar 40 KB de uma vez na janela de quem está no meio de outra coisa seria
    trocar um problema por outro.
    """
    r = core.ler(a.de, escopo="meu", avancar=False)
    if not r["msgs"]:
        return 0
    if r["bytes"] <= a.teto:
        print(f"📬 [ia-chat] {len(r['msgs'])} mensagem(ns) para você ({r['bytes']} B). "
              f"Já entregues abaixo — não precisa rodar nada.\n")
        for m in r["msgs"]:
            print(m["bruto"])
        core.marca_lida(a.de, max(m["n"] for m in r["msgs"]))
    else:
        print(f"📬 [ia-chat] {len(r['msgs'])} mensagem(ns) para você, {r['bytes']//1024} KB "
              f"— grande demais para entregar aqui. Cabeçalhos:")
        for m in r["msgs"]:
            print(f"   #{m['n']} de {m['de']}: {m['bruto'].splitlines()[2][:90]}")
        print(f"   Ler: `iachat read --de {a.de}`")
    return 0


def cmd_status(a) -> int:
    s = core.status()
    pct = 100 * s["bytes"] / s["teto_bytes"] if s["teto_bytes"] else 0
    print(f"chat      {s['chat']}")
    print(f"tamanho   {s['bytes']} B / {s['teto_bytes']} B ({pct:.0f}% do teto)")
    print(f"mensagens {s['mensagens']} (última #{s['ultima']})")
    print(f"na sala   {', '.join(s['na_sala'])}   brain: {s['brain']}")
    print(f"cursores  " + "  ".join(f"{k}:#{v}" for k, v in s["cursores"].items()))
    print(f"sino ativo{'  ' + ', '.join(s['pendentes']) if s['pendentes'] else '  (nenhum)'}")
    return 0


def _infra_de(ia: str) -> list[str]:
    """O que FALTA para esta IA receber de verdade. Lista vazia = pronta.

    Entrar na sala é só um nome no `config.json`. Receber é outra coisa: exige o sino
    (daemon ou hook) ligado na casca dela. Um nome sem infraestrutura vira membro que
    nunca é avisado — e quem o nomina fica esperando resposta que não vem, sem nada
    indicando o porquê. Este check é o que transforma "adicionei" em "adicionei e ela
    vai saber".
    """
    from pathlib import Path

    faltas = []
    label = f"com.bauer.ia-bell-{ia}"
    plist = Path.home() / "Library" / "LaunchAgents" / f"{label}.plist"
    if not plist.is_file():
        faltas.append(f"sino do Mac (rode: ia-bell-install-daemon.sh {ia})")

    settings = {
        "claude": Path.home() / ".claude/settings.json",
        "qwen": Path.home() / ".qwen/settings.json",
    }.get(ia)
    if settings and settings.is_file():
        if "ia-bell-hook.sh" not in settings.read_text(errors="replace"):
            faltas.append(f"hook de sessão (rode: ia-bell-install-hook.py {ia})")
    elif ia == "kimi":
        toml = Path.home() / ".kimi-code/config.toml"
        if not toml.is_file() or "ia-bell-hook.sh" not in toml.read_text(errors="replace"):
            faltas.append("hook de sessão (rode: ia-bell-install-hook.py kimi)")
    elif ia not in ("bauer",):
        faltas.append("hook de sessão: sem instalador conhecido para esta casca")
    return faltas


def cmd_entrar(a) -> int:
    """Põe uma IA na sala — e diz, na hora, se ela vai mesmo receber.

    Existia como "edite o config.json à mão", e o config aceitava qualquer nome: dava
    para pôr na sala uma casca que a infraestrutura não conhece, sem aviso nenhum.
    """
    import json

    ia = core.normaliza_ia(a.ia)
    cfg = core.config()
    sala = [core.normaliza_ia(x) for x in cfg.get("na_sala", [])]

    if a.sair:
        if ia not in sala:
            print(f"✗ {ia} não está na sala ({', '.join(sala)})")
            return 2
        cfg["na_sala"] = [x for x in sala if x != ia]
        core.p_config().write_text(json.dumps(cfg, ensure_ascii=False, indent=2) + "\n",
                                   encoding="utf-8")
        print(f"✔ {ia} saiu da sala · agora: {', '.join(cfg['na_sala'])}")
        print("  o histórico dela FICA — mensagem antiga não se apaga por saída.")
        return 0

    faltas = _infra_de(ia)
    if ia in sala:
        print(f"= {ia} já está na sala ({', '.join(sala)})")
    else:
        cfg["na_sala"] = sala + [ia]
        core.p_config().write_text(json.dumps(cfg, ensure_ascii=False, indent=2) + "\n",
                                   encoding="utf-8")
        print(f"✔ {ia} entrou · sala: {', '.join(cfg['na_sala'])}")
        print(f"  ⚠️  a partir de agora `@all` chama {ia} também.")

    if faltas:
        print(f"\n⚠️  {ia} está na sala mas NÃO vai receber sozinha — falta:")
        for f in faltas:
            print(f"     · {f}")
        print("   Até lá, ela só vê a sala se abrir por conta própria.")
        return 1          # binário: entrou, mas não está pronta. Quem chama sabe disso.
    print(f"\n✔ infraestrutura completa: {ia} recebe pelo sino e dentro da sessão.")
    return 0


def cmd_sino(a) -> int:
    """Liga/desliga o sino do dono sem confundir consentimento com infraestrutura."""
    cfg = core.config()
    if a.estado == "off":
        cfg = core.configurar_notificacao_operador(False)
    elif a.estado == "on":
        provado, motivo = _daemon_operador_da_sala(core.home())
        if not provado:
            # Um true antigo também é uma mentira se o daemon sumiu ou mudou de sala.
            # Falhar fechado aqui deixa o app e o CLI contando a mesma verdade.
            if cfg.get("notificar_operador") is True:
                cfg = core.configurar_notificacao_operador(False)
            instalador = Path(__file__).resolve().with_name(
                "ia-bell-install-daemon.sh"
            )
            print("sino do operador: 🔕 mudo", file=sys.stderr)
            print("  ✗ não liguei: %s" % motivo, file=sys.stderr)
            print(
                "  instale explicitamente: %s --operador" % instalador,
                file=sys.stderr,
            )
            print("  depois repita: iachat sino on", file=sys.stderr)
            return 1
        cfg = core.configurar_notificacao_operador(True)
    ligado = cfg.get("notificar_operador", False) is True
    if ligado:
        provado, motivo = _daemon_operador_da_sala(core.home())
        if not provado:
            if a.estado == "on":
                cfg = core.configurar_notificacao_operador(False)
            print("sino do operador: ⚠️ configurado, mas INOPERANTE")
            print("  %s" % motivo)
            return 1
    print("sino do operador: %s" % ("🔔 ligado" if ligado else "🔕 mudo"))
    if a.estado:
        print("  (vale no próximo ciclo do daemon, ~15s — não precisa reiniciar nada)")
    return 0


def _daemon_operador_da_sala(sala: Path) -> tuple[bool, str]:
    """Prova LaunchAgent vivo + plist de operador apontando para a sala exata."""
    label = "com.bauer.ia-bell-operador"
    plist = Path.home() / "Library" / "LaunchAgents" / (label + ".plist")
    try:
        with plist.open("rb") as arquivo:
            dados = plistlib.load(arquivo)
    except (OSError, ValueError, TypeError, plistlib.InvalidFileException):
        return False, "plist do operador ausente ou ilegível em %s" % plist

    if dados.get("Label") != label:
        return False, "plist não declara o label %s" % label
    argumentos = dados.get("ProgramArguments")
    if (
        not isinstance(argumentos, list)
        or len(argumentos) < 3
        or Path(str(argumentos[1])).name != "ia-bell-daemon.sh"
        or argumentos[2] != "--operador"
    ):
        return False, "plist não executa ia-bell-daemon.sh --operador"
    if dados.get("KeepAlive") is not True:
        return False, "plist do operador não garante KeepAlive"

    ambiente = dados.get("EnvironmentVariables")
    alvo = ambiente.get("IACHAT_HOME") if isinstance(ambiente, dict) else None
    if not isinstance(alvo, str) or not alvo.strip():
        return False, "plist não declara qual IACHAT_HOME vigia"
    try:
        sala_real = sala.expanduser().resolve()
        alvo_real = Path(alvo).expanduser().resolve()
    except OSError:
        return False, "não consegui resolver a sala declarada no plist"
    if alvo_real != sala_real:
        return False, "daemon aponta para outra sala (%s), não %s" % (
            alvo_real,
            sala_real,
        )

    try:
        proc = subprocess.run(
            ["launchctl", "list"],
            capture_output=True,
            text=True,
            timeout=10,
        )
    except (OSError, subprocess.SubprocessError):
        return False, "não consegui consultar o launchctl"
    if proc.returncode != 0:
        return False, "launchctl não confirmou o daemon do operador"
    for linha in proc.stdout.splitlines():
        campos = linha.split("\t")
        if len(campos) >= 3 and campos[2] == label:
            if campos[0].isdigit() and int(campos[0]) > 0:
                return True, "daemon PID %s vigia %s" % (campos[0], sala_real)
            return False, "LaunchAgent carregado, mas sem processo vivo"
    return False, "LaunchAgent %s não está carregado" % label


def cmd_reparar(a) -> int:
    """Reconstrói os flags do sino a partir do estado real. Idempotente."""
    r = core.reconstruir_flags()
    for ia, d in r.items():
        faixa = f" (#{d['faixa'][0]}…#{d['faixa'][1]})" if "faixa" in d else ""
        print(f"  {ia:8} {d['pendentes']} pendente(s){faixa} — {d['acao']}")
    print("\n(o flag é derivado do cursor × mensagens: reconstruir não inventa nada)")
    return 0


def cmd_assuntos(a) -> int:
    """Preenche o `Assuntos:` da marca de um recorte — a tarefa do brain."""
    try:
        r = core.marcar_assuntos(a.recorte, " ".join(a.texto))
    except ValueError as e:
        print(f"✗ {e}", file=sys.stderr)
        return 2
    if not r.get("ok"):
        print(f"✗ {r['erro']}", file=sys.stderr)
        return 2
    print(f"✔ {r['recorte']} · Assuntos: {r['assuntos']}")
    return 0


def cmd_rotate(a) -> int:
    r = core.rotate(forcar=a.forcar)
    if not r["rodou"]:
        print(f"= sem rotação: {r['motivo']}")
        return 0
    print(f"✔ {r['recorte']} — {r['cortadas']} mensagens (#{r['faixa'][0]}–#{r['faixa'][1]})")
    print(f"  ativo: {r['antes']} B → {r['depois']} B")
    print("  a marca ficou no ativo; o recorte é imutável e paginável")
    if r.get("aviso"):
        print(f"⚠️  {r['aviso']}", file=sys.stderr)
    return 0


def _rodape(r) -> str:
    ant = f"↑ pág {r['pagina']-1}" if r["pagina"] > 1 else "— início"
    prox = f"↓ pág {r['pagina']+1}" if r["pagina"] < r["total"] else "fim —"
    return (
        f"\n📄 {r['fonte']} · página {r['pagina']}/{r['total']} · "
        f"linhas {r['linhas'][0]}-{r['linhas'][1]} · {ant} · {prox}\n"
        f"   vizinha: iachat page {r['fonte']} <n>   (não relê o documento)"
    )


def cmd_page(a) -> int:
    r = core.paginar(a.fonte, a.pagina)
    if "erro" in r:
        print(f"✗ {r['erro']}", file=sys.stderr)
        return 2
    print(r["texto"])
    print(_rodape(r))
    return 0


def cmd_search(a) -> int:
    r = core.buscar(" ".join(a.termo), de=a.de, data=a.data)
    ac = r["achados"]
    if not ac:
        print("(nada encontrado)")
        return 0
    filtro = " ".join(x for x in [f"de={r['de']}" if r["de"] else "", f"data={r['data']}" if r["data"] else ""] if x)
    print(f"🔎 {len(ac)} mensagem(ns) casam com '{r['termo']}' {filtro}".rstrip())

    # Mensagem RETRATADA tem que vir marcada aqui, não só no `iachat-retratar search`.
    # Sem isto, quem procura daqui a uma semana acha a versão errada e a correção lado a
    # lado, sem nada dizendo qual vale — numa sala onde IAs decidem a partir do que leem,
    # é dado envenenado com prazo indeterminado. A peça `ia-retratar` deixou este gap
    # declarado: a integração mora no núcleo, que era fronteira proibida para ela.
    #
    # A varredura é sobre o HISTÓRICO parseado (recortes + ativo), a mesma fonte que a
    # peça usa — e não sobre o índice da busca. Motivo medido: o achado de `core.buscar`
    # traz `linha` como NÚMERO da linha, não como conteúdo, e `n` como string. Um regex
    # sobre `linha` nunca casaria, e o `except` teria escondido isso para sempre — o
    # índice sairia sem marca, calado, exatamente como antes.
    retratado: dict[str, str] = {}
    try:
        import re as _re

        for caminho in core._recortes() + [core.p_chat()]:
            for msg in core.parse(caminho.read_text(errors="replace")):
                corpo = msg.get("bruto", "")
                # o vínculo canônico é a PRIMEIRA linha do corpo da retratação
                primeira = next(
                    (ln.strip() for ln in corpo.split("\n\n", 1)[-1].splitlines()
                     if ln.strip()), "")
                m = _re.fullmatch(r"retrata:\s*#(\d+)", primeira)
                if m:
                    alvo = m.group(1)
                    # correção de correção: a mais recente é a vigente
                    if int(msg["n"]) > int(retratado.get(alvo, 0)):
                        retratado[alvo] = str(msg["n"])
    except Exception:
        retratado = {}    # na dúvida, índice SEM marca — nunca com marca errada

    for x in ac[:12]:
        marca = (f"  ⚠ RETRATADA → #{retratado[str(x['n'])]}"
                 if str(x["n"]) in retratado else "")
        print(f"   {x['fonte']:34} #{x['n']:<3} {x['de']:7} {x['ts']}  → página {x['pagina']}{marca}")
    if len(ac) > 12:
        print(f"   … e mais {len(ac)-12}")
    if not a.abrir:
        # O índice sozinho responde "onde está?" por ~84 tokens. Abrir a página junto
        # custava ~1.097 — 13× mais — para quem só queria localizar. Medido em 17/08
        # (achado do grok): o comando que existe para economizar contexto desperdiçava
        # por padrão. Agora abrir é escolha de quem pergunta.
        print(f"\n   abrir: iachat page {ac[0]['fonte']} {ac[0]['pagina']}"
              f"   (ou repita a busca com --abrir)")
        return 0
    p = core.paginar(ac[0]["fonte"], ac[0]["pagina"])
    print(f"\n─── primeira ocorrência ───\n")
    print(p["texto"])
    print(_rodape(p))
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(prog="iachat", description=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("post", help="postar mensagem (toca o sino dos nominados)")
    p.add_argument("--de", required=True, help="quem está postando")
    p.add_argument("--para", action="append", help="destinos: codex,kimi ou @all")
    p.add_argument("texto", nargs="*", help="corpo (vazio = lê do stdin)")
    p.set_defaults(f=cmd_post)

    p = sub.add_parser("read", help="ler a sala")
    p.add_argument("--de", required=True, help="quem está lendo")
    p.add_argument("--todas", action="store_true", help="+ conversa entre terceiros")
    p.add_argument("--tudo", action="store_true", help="a sala inteira (caro, explícito)")
    p.add_argument("--novas", action="store_true", help="(compat: já é o padrão)")
    p.add_argument("--sem-avancar", action="store_true", help="não mexer no cursor")
    p.set_defaults(f=cmd_read)

    p = sub.add_parser("entregar", help="saída para hook: injeta a mensagem no contexto")
    p.add_argument("--de", required=True)
    p.add_argument("--teto", type=int, default=6144, help="bytes; acima disso só cabeçalhos")
    p.set_defaults(f=cmd_entregar)

    p = sub.add_parser("status", help="estado da sala")
    p.set_defaults(f=cmd_status)

    p = sub.add_parser("entrar", help="pôr (ou tirar) uma IA da sala, conferindo a infra")
    p.add_argument("ia", help="nome da IA")
    p.add_argument("--sair", action="store_true", help="tira em vez de pôr")
    p.set_defaults(f=cmd_entrar)

    p = sub.add_parser("sino", help="notificação do operador: ligar, desligar, ver")
    p.add_argument("estado", nargs="?", choices=["on", "off"], help="vazio = só mostra")
    p.set_defaults(f=cmd_sino)

    p = sub.add_parser("assuntos", help="preencher os Assuntos da marca de um recorte")
    p.add_argument("recorte", help="recorte-01, ou o nome do arquivo")
    p.add_argument("texto", nargs="+", help="os assuntos, separados por ·")
    p.set_defaults(f=cmd_assuntos)

    p = sub.add_parser("reparar", help="reconstrói os flags do sino a partir do estado real")
    p.set_defaults(f=cmd_reparar)

    p = sub.add_parser("rotate", help="corta o ativo de cima e arquiva num recorte")
    p.add_argument("--forcar", action="store_true", help="rodar mesmo abaixo do teto")
    p.set_defaults(f=cmd_rotate)

    p = sub.add_parser("page", help="uma página de um recorte (paginação estável)")
    p.add_argument("fonte", help="recorte-01, o nome do arquivo, ou 'ativo'")
    p.add_argument("pagina", type=int, nargs="?", default=1)
    p.set_defaults(f=cmd_page)

    p = sub.add_parser("search", help="achar sem pagar o arquivo inteiro")
    p.add_argument("termo", nargs="*", help="texto a procurar")
    p.add_argument("--de", help="só mensagens desta IA")
    p.add_argument("--data", help="prefixo ISO, ex: 2026-08-17")
    p.add_argument("--abrir", action="store_true", help="também trazer a 1ª ocorrência")
    p.set_defaults(f=cmd_search)

    a = ap.parse_args()
    return a.f(a)


if __name__ == "__main__":
    sys.exit(main())
